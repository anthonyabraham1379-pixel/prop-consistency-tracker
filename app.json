{
  "expo": {
    "name": "Vencia",
    "slug": "prop-consistency-tracker",
    "version": "1.0.0",
    "scheme": "propconsistencytracker",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "prop.tracker",
      "adaptiveIcon": {
        "backgroundColor": "#08090D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9426422393740746~3165470957",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-transparent.png",
          "imageWidth": 1,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/splash-transparent.png"
          }
        }
      ],
      "expo-asset",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "f95850f7-1867-4a40-bbee-c96ac925ca9d"
      }
    },
    "owner": "anthonyaal"
  }
}
