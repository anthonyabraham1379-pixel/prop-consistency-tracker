//@version=6
// =============================================================================
//  LECTOR ESTRUCTURAL   ·   Indicador de FASES   ·   Pine Script v6
// -----------------------------------------------------------------------------
//  QUÉ ES
//    Un lector del ESTADO de la estructura del precio. Describe en qué fase de
//    la secuencia se encuentra el mercado:
//        nivel → barrida/rechazo → ruptura → retesteo → fallo del retesteo
//    y si el contexto (HTF, VWAP, EMA, espacio hasta el próximo nivel) acompaña.
//
//  QUÉ NO ES
//    No es una estrategia. No usa strategy.entry ni strategy.exit. No genera
//    órdenes. No dice comprar ni vender, no marca long ni short, no sugiere
//    entradas, salidas ni tamaño de posición. Las referencias de riesgo son
//    sólo distancias geométricas de la propia estructura.
//
//  ANTI-REPINTADO
//    Las transiciones de fase se evalúan sobre vela cerrada
//    (barstate.isconfirmed), los pivotes son pivotes confirmados y los datos
//    del timeframe superior se piden con offset [1] + lookahead_on, que es la
//    forma no repintable de leer una vela HTF ya cerrada.
//
//  INSTRUMENTOS
//    Neutro: todos los umbrales se expresan en ticks sobre syminfo.mintick, así
//    que el motor funciona en cualquier instrumento. El perfil (Auto, ES/MES,
//    NQ/MNQ, Manual) sólo cambia los VALORES INICIALES de tolerancia,
//    desplazamiento, ancho de zona y distancia mínima de invalidación.
//    No hay valores de dinero ni tamaño de contrato en ninguna parte.
//
//  NOMENCLATURA
//    "BARRIDA SUPERIOR" = secuencia nacida de una barrida por arriba.
//    "BARRIDA INFERIOR" = secuencia nacida de una barrida por abajo.
//    Describen de qué lado se barrió la liquidez, no una dirección operativa.
// =============================================================================

indicator("Lector Estructural · Fases", "ESTRUCTURA", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// =============================================================================
// 1 · INPUTS
// =============================================================================
G_INS = "0 · Perfil de instrumento"
G_SES = "1 · Sesión y contexto temporal"
G_LVL = "2 · Niveles de referencia"
G_FLT = "3 · Filtros de contexto"
G_STR = "4 · Detección estructural"
G_RSK = "5 · Referencias de invalidación"
G_RPT = "6 · Control de repetición"
G_VIS = "7 · Visual"

// --- 0 · perfil de instrumento -----------------------------------------------
i_profile = input.string("Auto", "Perfil de instrumento",
     options = ["Auto", "ES/MES", "NQ/MNQ", "Manual"], group = G_INS,
     tooltip = "Auto detecta el instrumento con syminfo.root. Si no reconoce la raíz " +
       "usa el perfil Manual, es decir, los valores del grupo 4 y del grupo 5.")

// --- 1 · sesión --------------------------------------------------------------
i_tz       = input.string("America/New_York", "Zona horaria",
     options = ["America/New_York", "America/Chicago", "Europe/Madrid", "UTC"], group = G_SES)
i_sesRTH   = input.session("0930-1600", "Sesión regular (RTH)", group = G_SES)
i_sesON    = input.session("1800-0930", "Sesión overnight",     group = G_SES)
i_htf      = input.timeframe("15",      "Timeframe de contexto (HTF)", group = G_SES)
i_orMin    = input.int(15, "Opening Range (minutos desde la apertura)", minval = 1, maxval = 240, group = G_SES)
i_onlyRTH  = input.bool(false, "Analizar sólo dentro de la sesión regular", group = G_SES)
i_resetSes = input.bool(true,  "Reiniciar secuencias y avisos en cada apertura", group = G_SES)

// --- 2 · niveles -------------------------------------------------------------
i_showON   = input.bool(true, "Máximo / mínimo overnight",      group = G_LVL)
i_showPD   = input.bool(true, "Máximo / mínimo del día previo", group = G_LVL)
i_showOR   = input.bool(true, "Opening Range",                  group = G_LVL)
i_showPiv  = input.bool(true, "Pivotes intradía confirmados",   group = G_LVL)
i_pivLeft  = input.int(3, "Sensibilidad de pivote · velas a la izquierda", minval = 1, maxval = 50, group = G_LVL)
i_pivRight = input.int(3, "Sensibilidad de pivote · velas a la derecha",   minval = 1, maxval = 50, group = G_LVL)
i_lvlTags  = input.bool(true, "Etiquetar los niveles en la última vela", group = G_LVL)

// --- 3 · filtros de contexto -------------------------------------------------
i_useEma    = input.bool(true, "Filtro EMA local", group = G_FLT)
i_emaLen    = input.int(20, "· Longitud EMA local", minval = 2, group = G_FLT)
i_useVwap   = input.bool(true, "Filtro VWAP de sesión", group = G_FLT)
i_useHtfEma = input.bool(true, "Filtro EMA del timeframe superior", group = G_FLT)
i_htfEmaLen = input.int(20, "· Longitud EMA HTF", minval = 2, group = G_FLT)
i_useHtfStr = input.bool(true, "Filtro secuencia de máximos/mínimos HTF", group = G_FLT)
i_htfPiv    = input.int(2, "· Sensibilidad de pivote HTF", minval = 1, maxval = 20, group = G_FLT)
i_useRoom   = input.bool(false, "Filtro espacio libre hasta el próximo nivel", group = G_FLT)
i_roomR     = input.float(1.5, "· Espacio mínimo (× distancia mínima de invalidación)", minval = 0.1, step = 0.1, group = G_FLT)

// --- 4 · detección estructural ----------------------------------------------
i_tolTicks  = input.int(4, "Tolerancia de barrida / retesteo (ticks)", minval = 0, maxval = 100, group = G_STR,
     tooltip = "Valor manual. Se aplica con el perfil Manual, o cuando Auto no reconoce el instrumento.")
i_wick      = input.float(0.50, "Mecha mínima de rechazo (proporción del rango de la vela)", minval = 0.10, maxval = 0.90, step = 0.05, group = G_STR)
i_dispTicks = input.int(12, "Desplazamiento mínimo tras la ruptura (ticks)", minval = 0, maxval = 400, group = G_STR,
     tooltip = "Valor manual. Se aplica con el perfil Manual, o cuando Auto no reconoce el instrumento.")
i_maxRetestTicks = input.int(12, "Ancho máximo de zona de retesteo (ticks)", minval = 1, maxval = 100, group = G_STR,
     tooltip = "Valor manual. Se aplica con el perfil Manual, o cuando Auto no reconoce el instrumento.")
i_lookback  = input.int(20, "Ventana de la estructura del pullback (velas)", minval = 3, maxval = 200, group = G_STR)
i_maxBars   = input.int(30, "Velas máximas por fase antes de expirar", minval = 3, maxval = 500, group = G_STR)
i_confirm   = input.bool(true, "Confirmar sólo con velas cerradas (anti-repintado)", group = G_STR)

// --- 5 · referencias de invalidación ----------------------------------------
i_minInvPts = input.float(4.75, "Distancia mínima de invalidación (puntos)", minval = 0.0, step = 0.25, group = G_RSK,
     tooltip = "Valor manual en puntos del instrumento. Se aplica con el perfil Manual, " +
       "o cuando Auto no reconoce el instrumento.")
i_showRefs  = input.bool(true, "Dibujar referencias 1R y 2R", group = G_RSK)
i_refBars   = input.int(25, "Longitud de las líneas de referencia (velas)", minval = 3, maxval = 200, group = G_RSK)

// --- 6 · control de repetición ----------------------------------------------
i_maxFails   = input.int(2, "Fallas en la misma zona antes de avisar pausa", minval = 1, maxval = 10, group = G_RPT)
i_sameLvlPts = input.float(2.0, "Margen para considerar «mismo nivel» (puntos)", minval = 0.0, step = 0.25, group = G_RPT)

// --- 7 · visual --------------------------------------------------------------
i_showBoxes  = input.bool(true, "Dibujar zonas (barrida, ruptura, retesteo)", group = G_VIS)
i_showLabels = input.bool(true, "Dibujar etiquetas de fase", group = G_VIS)
i_showTable  = input.bool(true, "Mostrar panel de estado", group = G_VIS)
i_panelMode  = input.string("Compacto", "Modo del panel", options = ["Móvil", "Compacto", "Detallado"], group = G_VIS,
     tooltip = "Móvil: dos columnas y sólo glifos, para pantallas estrechas. " +
       "Compacto: cinco filas con una palabra. Detallado: la tabla larga.")
i_panelPos   = input.string("Superior derecha", "Posición del panel", group = G_VIS,
     options = ["Superior izquierda", "Superior centro", "Superior derecha", "Centro izquierda", "Centro derecha", "Inferior izquierda", "Inferior centro", "Inferior derecha"])
i_panelSize  = input.string("Mediano", "Tamaño del texto del panel", options = ["Pequeño", "Mediano", "Grande"], group = G_VIS)
i_symbols    = input.bool(true, "Etiquetas como símbolo (el detalle va en el tooltip)", group = G_VIS)
i_maxDraw    = input.int(3, "Estructuras recientes a mantener en pantalla", minval = 1, maxval = 20, group = G_VIS)
cOk   = input.color(#26a69a, "Color · estructura completa y alineada",  group = G_VIS)
cNeu  = input.color(#5b8def, "Color · estructura sin alineación total", group = G_VIS)
cWarn = input.color(#f0b90b, "Color · fase intermedia y advertencias",  group = G_VIS)
cLvl  = input.color(#787b86, "Color · niveles",                         group = G_VIS)
cOff  = input.color(#4f5966, "Color · estructura invalidada",           group = G_VIS)

// --- símbolos de fase --------------------------------------------------------
// El gráfico habla con glifos y color; el texto completo vive en el tooltip.
SYM_LVL   = "•"   // nivel alcanzado
SYM_SWEEP = "◇"   // posible barrida
SYM_REJ   = "◆"   // rechazo detectado
SYM_BOS   = "▬"   // ruptura estructural
SYM_WAIT  = "⋯"   // esperando retesteo
SYM_RET   = "◎"   // retesteo en observación
SYM_DONE  = "●"   // estructura completa
SYM_APLUS = "★"   // estructura completa con contexto alineado
SYM_INV   = "✕"   // estructura invalidada
SYM_WARN  = "⚠"   // advertencia
SYM_PAUSE = "‖"   // pausa sugerida
SYM_R1    = "◐"   // referencia 1R alcanzada
SYM_OFF   = "○"   // fase no alcanzada

// =============================================================================
// 2 · CÁLCULOS BÁSICOS
// =============================================================================
// --- perfil de instrumento ---------------------------------------------------
// Valores INICIALES por perfil. Todo en ticks salvo la distancia mínima de
// invalidación, que va en puntos porque depende del ruido típico del producto.
P_ES_TOL    = 4
P_ES_DISP   = 12
P_ES_RETEST = 12
P_ES_MININV = 4.75
P_NQ_TOL    = 6       // rango razonable 4-8
P_NQ_DISP   = 16
P_NQ_RETEST = 16      // rango razonable 12-20
P_NQ_MININV = 8.0

// Detección por raíz del símbolo. str.tostring() protege el caso de raíz vacía
// o na: entonces no coincide con nada y se cae al perfil Manual, sin romper.
rootU  = str.upper(str.tostring(syminfo.root))
detES  = rootU == "ES" or rootU == "MES"
detNQ  = rootU == "NQ" or rootU == "MNQ"
profAuto = detES ? "ES/MES" : detNQ ? "NQ/MNQ" : "Manual"
profUsed = i_profile == "Auto" ? profAuto : i_profile

tolTicksEff    = profUsed == "ES/MES" ? P_ES_TOL    : profUsed == "NQ/MNQ" ? P_NQ_TOL    : i_tolTicks
dispTicksEff   = profUsed == "ES/MES" ? P_ES_DISP   : profUsed == "NQ/MNQ" ? P_NQ_DISP   : i_dispTicks
retestTicksEff = profUsed == "ES/MES" ? P_ES_RETEST : profUsed == "NQ/MNQ" ? P_NQ_RETEST : i_maxRetestTicks
minInvEff      = profUsed == "ES/MES" ? P_ES_MININV : profUsed == "NQ/MNQ" ? P_NQ_MININV : i_minInvPts

tick      = syminfo.mintick           // toda la métrica del indicador sale de aquí
tol       = tolTicksEff    * tick
disp      = dispTicksEff   * tick
maxRetest = retestTicksEff * tick     // techo del ancho de la zona de retesteo

// --- sesiones ----------------------------------------------------------------
inRTH   = not na(time(timeframe.period, i_sesRTH, i_tz))
inON    = not na(time(timeframe.period, i_sesON,  i_tz))
rthOpen = inRTH and not inRTH[1]

// --- máximo / mínimo overnight (se congelan al abrir la sesión regular) -------
var float onHacc = na
var float onLacc = na
if inON and not inON[1]
    onHacc := high
    onLacc := low
else if inON
    onHacc := math.max(nz(onHacc, high), high)
    onLacc := math.min(nz(onLacc, low),  low)

var float onH = na
var float onL = na
if rthOpen
    onH := onHacc
    onL := onLacc

// --- máximo / mínimo del día previo (día ya cerrado: no repinta) --------------
pdH = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
pdL = request.security(syminfo.tickerid, "D", low[1],  lookahead = barmerge.lookahead_on)

// --- opening range -----------------------------------------------------------
var float orH     = na
var float orL     = na
var int   orStart = na
var bool  orDone  = false
if rthOpen
    orH     := high
    orL     := low
    orStart := time
    orDone  := false
else if inRTH and not orDone and not na(orStart)
    if time <= orStart + i_orMin * 60000
        orH := math.max(nz(orH, high), high)
        orL := math.min(nz(orL, low),  low)
    else
        orDone := true

// --- pivotes confirmados -----------------------------------------------------
phVal = ta.pivothigh(high, i_pivLeft, i_pivRight)
plVal = ta.pivotlow(low,   i_pivLeft, i_pivRight)
var float lastPH = na
var float lastPL = na
if not na(phVal)
    lastPH := phVal
if not na(plVal)
    lastPL := plVal

// --- medias, vwap, extremos, mechas -----------------------------------------
emaLoc  = ta.ema(close, i_emaLen)
vwapVal = ta.vwap(hlc3)
loN     = ta.lowest(low,   i_lookback)
hiN     = ta.highest(high, i_lookback)
barRng  = math.max(high - low, tick)
wickUp  = (high - math.max(open, close)) / barRng
wickDn  = (math.min(open, close) - low)  / barRng

// --- sesgo estructural: secuencia de máximos y mínimos confirmados -----------
// 1 = máximos y mínimos ascendentes · -1 = descendentes · 0 = mixto
f_structBias(simple int lb) =>
    var float h0 = na
    var float h1 = na
    var float l0 = na
    var float l1 = na
    ph = ta.pivothigh(high, lb, lb)
    pl = ta.pivotlow(low,   lb, lb)
    if not na(ph)
        h1 := h0
        h0 := ph
    if not na(pl)
        l1 := l0
        l0 := pl
    up = not na(h1) and not na(l1) and h0 > h1 and l0 > l1
    dn = not na(h1) and not na(l1) and h0 < h1 and l0 < l1
    up ? 1 : dn ? -1 : 0

locStruct = f_structBias(i_pivLeft)

// --- paquete de contexto HTF (vela HTF ya cerrada) ---------------------------
f_htfPack(simple int emaLen, simple int pivLb) =>
    c = close
    e = ta.ema(close, emaLen)
    b = f_structBias(pivLb)
    [c[1], e[1], b[1]]

[htfCloseR, htfEmaR, htfStructR] = request.security(syminfo.tickerid, i_htf,
     f_htfPack(i_htfEmaLen, i_htfPiv), lookahead = barmerge.lookahead_on)
htfClose  = nz(htfCloseR, close)
htfEmaV   = nz(htfEmaR,   close)
htfStruct = nz(htfStructR, 0)

// =============================================================================
// 3 · NIVELES ACTIVOS
// =============================================================================
var array<float>  lvlP = array.new<float>()
var array<string> lvlN = array.new<string>()

f_addLevel(float p, string n, bool on) =>
    if on and not na(p)
        array.push(lvlP, p)
        array.push(lvlN, n)

array.clear(lvlP)
array.clear(lvlN)
f_addLevel(onH,    "ON H",  i_showON)
f_addLevel(onL,    "ON L",  i_showON)
f_addLevel(pdH,    "PDH",   i_showPD)
f_addLevel(pdL,    "PDL",   i_showPD)
f_addLevel(orH,    "OR H",  i_showOR)
f_addLevel(orL,    "OR L",  i_showOR)
f_addLevel(lastPH, "PIV H", i_showPiv)
f_addLevel(lastPL, "PIV L", i_showPiv)

// Distancia hasta el nivel más cercano por debajo (o por encima) del cierre.
f_room(bool below) =>
    float best = na
    if array.size(lvlP) > 0
        for i = 0 to array.size(lvlP) - 1
            L = array.get(lvlP, i)
            d = below ? close - L : L - close
            if d > tol and (na(best) or d < best)
                best := d
    best

roomDn = f_room(true)
roomUp = f_room(false)

// =============================================================================
// 4 · CONTEXTO  ·  0 = CONTRARIO · 1 = MIXTO · 2 = ALINEADO
// =============================================================================
f_ctx(bool upper) =>
    int tot = 0
    int ok  = 0
    int bad = 0
    if i_useEma
        tot += 1
        cE = upper ? close < emaLoc : close > emaLoc
        ok  += cE ? 1 : 0
        bad += cE ? 0 : 1
    if i_useVwap
        tot += 1
        cV = upper ? close < vwapVal : close > vwapVal
        ok  += cV ? 1 : 0
        bad += cV ? 0 : 1
    if i_useHtfEma
        tot += 1
        cH = upper ? htfClose < htfEmaV : htfClose > htfEmaV
        ok  += cH ? 1 : 0
        bad += cH ? 0 : 1
    if i_useHtfStr
        tot += 1
        cS = upper ? htfStruct == -1 : htfStruct == 1
        cX = upper ? htfStruct == 1  : htfStruct == -1
        ok  += cS ? 1 : 0
        bad += cX ? 1 : 0
    if i_useRoom
        tot += 1
        r  = upper ? roomDn : roomUp
        cR = na(r) or r >= i_roomR * minInvEff
        ok  += cR ? 1 : 0
        bad += cR ? 0 : 1
    tot == 0 ? 1 : ok == tot ? 2 : (ok == 0 and bad > 0) ? 0 : 1

ctxUp = f_ctx(true)
ctxDn = f_ctx(false)

f_ctxTxt(st) => st == 2 ? "CONTEXTO ALINEADO" : st == 0 ? "CONTEXTO CONTRARIO" : "CONTEXTO MIXTO"
f_ctxCol(st) => st == 2 ? cOk : st == 0 ? cWarn : cNeu

// =============================================================================
// 5 · GESTIÓN DE OBJETOS GRÁFICOS (límite controlado)
// =============================================================================
var array<box>   gBoxes  = array.new<box>()
var array<label> gLabels = array.new<label>()
var array<line>  gLines  = array.new<line>()

f_trimBoxes(int maxN) =>
    while array.size(gBoxes) > maxN
        box.delete(array.shift(gBoxes))

f_trimLabels(int maxN) =>
    while array.size(gLabels) > maxN
        label.delete(array.shift(gLabels))

f_trimLines(int maxN) =>
    while array.size(gLines) > maxN
        line.delete(array.shift(gLines))

f_box(int x1, float y1, int x2, float y2, color c, int transp) =>
    if i_showBoxes
        b = box.new(x1, math.max(y1, y2), x2, math.min(y1, y2),
             border_color = color.new(c, 65), bgcolor = color.new(c, transp), border_width = 1)
        array.push(gBoxes, b)
        f_trimBoxes(i_maxDraw * 3)

// Marca de fase: un glifo en el gráfico, la descripción completa en el tooltip.
f_tag(int x, float y, string sym, string tip, color c, bool below) =>
    if i_showLabels
        if i_symbols
            l = label.new(x, y, sym,
                 style     = below ? label.style_label_up : label.style_label_down,
                 color     = color.new(c, 20),
                 textcolor = color.white,
                 size      = size.normal,
                 tooltip   = tip)
            array.push(gLabels, l)
        else
            l = label.new(x, y, sym + "  " + tip,
                 style     = below ? label.style_label_up : label.style_label_down,
                 color     = color.new(c, 15),
                 textcolor = color.white,
                 size      = size.tiny,
                 tooltip   = tip)
            array.push(gLabels, l)
        f_trimLabels(i_maxDraw * 10)

// Línea de referencia: etiqueta mínima, texto completo en el tooltip.
f_ref(float y, string sym, string tip, color c, bool dotted) =>
    ln = line.new(bar_index, y, bar_index + i_refBars, y,
         color = color.new(c, 35), style = dotted ? line.style_dotted : line.style_dashed, width = 1)
    array.push(gLines, ln)
    f_trimLines(i_maxDraw * 5)
    if i_showLabels
        l = label.new(bar_index + i_refBars, y, i_symbols ? sym : sym + " " + tip,
             style = label.style_label_left, color = color.new(c, 90), textcolor = c,
             size = size.tiny, tooltip = tip)
        array.push(gLabels, l)
        f_trimLabels(i_maxDraw * 10)

// =============================================================================
// 6 · ESTADO DE UNA SECUENCIA
// =============================================================================
//  phase 0 · sin secuencia activa
//  phase 1 · NIVEL ALCANZADO                       (falta barrida o rechazo)
//  phase 2 · POSIBLE BARRIDA / RECHAZO DETECTADO   (falta ruptura)
//  phase 3 · RUPTURA ESTRUCTURAL · ESPERANDO RETESTEO
//  phase 4 · RETESTEO EN OBSERVACIÓN               (falta rechazo del retesteo)
//  phase 5 · ESTRUCTURA COMPLETA
type Seq
    int    phase     = 0
    float  lvl       = na     // nivel de referencia de la secuencia
    string lvlName   = ""
    float  ext       = na     // extremo de la barrida = punto de invalidación
    int    tBar      = 0      // barra del último cambio de fase
    float  structLvl = na     // extremo del pullback que debe romperse
    float  zLo       = na     // zona de ruptura / retesteo
    float  zHi       = na
    bool   moved     = false  // desplazamiento mínimo alcanzado
    int    movedBar  = -1     // vela que confirmó el desplazamiento mínimo
    int    lastEvtBar = -1    // vela del último arranque de secuencia
    float  refPx     = na     // referencia estructural al completarse
    float  invPx     = na     // nivel de invalidación
    float  dist      = na     // distancia de invalidación en puntos
    bool   r1        = false  // se alcanzó la referencia 1R
    int    fails     = 0      // fallas acumuladas en la misma zona
    float  failLvl   = na
    float  doneLvl   = na     // nivel de la última estructura completada
    int    ctxDone   = 1      // contexto en el momento de completarse
    string note      = ""     // texto del estado actual
    string missing   = ""     // qué falta para completar la secuencia
    string warn      = ""     // aviso de repetición / pausa

var Seq seqUp = Seq.new()   // secuencia nacida de una barrida por ARRIBA
var Seq seqDn = Seq.new()   // secuencia nacida de una barrida por ABAJO

// --- eventos en los niveles --------------------------------------------------
//  rango interno de prioridad : 3 barrida · 2 rechazo · 1 sólo contacto
//  evento devuelto            : 2 POSIBLE BARRIDA · 3 RECHAZO DETECTADO ·
//                               1 NIVEL ALCANZADO · 0 nada
//  La barrida real tiene prioridad sobre el rechazo, tanto en la misma vela
//  como frente a un rechazo en otro nivel.
f_scan(bool upper) =>
    int    rank = 0
    float  bp   = na
    string bn   = ""
    if array.size(lvlP) > 0
        for i = 0 to array.size(lvlP) - 1
            L  = array.get(lvlP, i)
            // contacto: el extremo de la vela entra en la banda del nivel
            tU = high >= L - tol and high <= L + tol
            tD = low  <= L + tol and low  >= L - tol
            // barrida: se atraviesa el nivel y la vela cierra de vuelta dentro
            sU = high > L + tol and close < L and close[1] <= L + tol
            sD = low  < L - tol and close > L and close[1] >= L - tol
            // rechazo: contacto REAL con el nivel (banda estricta por ambos
            // lados), cierre del lado correcto y mecha mínima configurable.
            // Una mecha grande lejos del nivel ya no cuenta como rechazo.
            rU = tU and close < L and wickUp >= i_wick
            rD = tD and close > L and wickDn >= i_wick
            touched = upper ? tU : tD
            swept   = upper ? sU : sD
            rejec   = upper ? rU : rD
            r = swept ? 3 : rejec ? 2 : touched ? 1 : 0
            if r > rank
                rank := r
                bp   := L
                bn   := array.get(lvlN, i)
    evt = rank == 3 ? 2 : rank == 2 ? 3 : rank == 1 ? 1 : 0
    [evt, bp, bn]

[evtUp, lvlUpP, lvlUpN] = f_scan(true)
[evtDn, lvlDnP, lvlDnN] = f_scan(false)

confirmed = not i_confirm or barstate.isconfirmed
analyzing = (not i_onlyRTH or inRTH) and confirmed

// =============================================================================
// 7 · MÁQUINA DE ESTADOS
// =============================================================================
//  Eventos devueltos:
//   0 nada · 1 nivel alcanzado · 2 posible barrida · 3 rechazo detectado
//   4 ruptura estructural · 5 esperando retesteo (desplazamiento confirmado)
//   6 retesteo en observación · 7 estructura completa · 8 estructura invalidada
f_step(Seq s, bool upper, int evt, float elvl, string ename) =>
    int ev = 0

    // --- reinicio opcional en la apertura de la sesión regular ---------------
    if i_resetSes and rthOpen
        s.phase     := 0
        s.fails     := 0
        s.failLvl   := na
        s.doneLvl   := na
        s.r1        := false
        s.note      := ""
        s.missing   := ""
        s.warn      := ""
        s.ext       := na
        s.structLvl := na
        s.zLo       := na
        s.zHi       := na
        s.moved     := false

    if analyzing
        // --- caducidad de la fase actual -------------------------------------
        if s.phase > 0 and s.phase < 5 and bar_index - s.tBar > i_maxBars
            s.phase     := 0
            s.note      := "SECUENCIA EXPIRADA"
            s.missing   := ""
            s.moved     := false
            s.ext       := na
            s.structLvl := na
            s.zLo       := na
            s.zHi       := na

        // --- invalidación: se pierde el EXTREMO CONGELADO de la barrida ------
        //     s.ext no se recalcula nunca: es el high (o low) de la vela de
        //     detección, así que esta comparación es siempre contra el mismo
        //     precio desde que arrancó la secuencia.
        beyond  = upper ? close > nz(s.ext, close) + tol : close < nz(s.ext, close) - tol
        lostExt = s.phase >= 2 and not na(s.ext) and beyond

        if lostExt
            // Sólo cuenta como FALLA una estructura que llegó a completarse;
            // una fase intermedia invalidada no suma al contador.
            if s.phase == 5
                sameZone  = not na(s.failLvl) and math.abs(s.failLvl - s.lvl) <= i_sameLvlPts
                s.fails   := sameZone ? s.fails + 1 : 1
                s.failLvl := s.lvl
                s.warn    := ""
                if s.fails >= 2
                    s.warn := "SEGUNDA FALLA EN LA MISMA ZONA"
                if s.fails >= i_maxFails
                    s.warn := s.warn == "" ? "PAUSA Y ESPERAR NUEVA ESTRUCTURA" : s.warn + " · PAUSA Y ESPERAR NUEVA ESTRUCTURA"
            s.phase     := 0
            s.note      := "ESTRUCTURA INVALIDADA"
            s.missing   := ""
            s.moved     := false
            s.ext       := na
            s.structLvl := na
            s.zLo       := na
            s.zHi       := na
            ev := 8
            f_tag(bar_index, upper ? high : low, SYM_INV, "ESTRUCTURA INVALIDADA", cOff, not upper)
        else
            // Una misma vela no puede arrancar dos veces la secuencia.
            starting = (s.phase <= 1 or s.phase == 5) and evt >= 2 and bar_index > s.lastEvtBar

            // ============ arranque de secuencia: barrida o rechazo ===========
            if starting
                // una secuencia nueva en OTRO nivel limpia los avisos previos
                if na(s.failLvl) or math.abs(s.failLvl - elvl) > i_sameLvlPts
                    s.fails := 0
                    s.warn  := ""
                slUp = (not na(lastPL) and lastPL < close) ? lastPL : loN
                slDn = (not na(lastPH) and lastPH > close) ? lastPH : hiN
                s.lvl       := elvl
                s.lvlName   := ename
                // EXTREMO CONGELADO: se fija aquí, en la vela de detección de
                // la barrida o del rechazo, y no vuelve a tocarse en las fases
                // 2, 3, 4 ni 5. Es el punto de invalidación de la secuencia.
                s.ext       := upper ? high : low
                s.structLvl := upper ? slUp : slDn
                s.zLo       := na
                s.zHi       := na
                s.moved     := false
                s.movedBar  := -1
                s.phase     := 2
                s.tBar      := bar_index
                s.lastEvtBar := bar_index
                s.note      := evt == 3 ? "RECHAZO DETECTADO" : "POSIBLE BARRIDA"
                s.missing   := "FALTA RUPTURA"
                ev := evt
                f_box(bar_index - 1, s.lvl, bar_index + 1, s.ext, cWarn, 86)
                f_tag(bar_index, upper ? high : low, evt == 3 ? SYM_REJ : SYM_SWEEP, s.note + " · " + ename, cWarn, not upper)

            // ============ fase 0 / 1 · sólo se alcanzó el nivel ==============
            else if s.phase <= 1
                nuevo = s.phase == 0 or na(s.lvl) or math.abs(s.lvl - elvl) > tol
                if evt == 1 and nuevo
                    s.lvl     := elvl
                    s.lvlName := ename
                    s.phase   := 1
                    s.tBar    := bar_index
                    s.note    := "NIVEL ALCANZADO"
                    s.missing := "FALTA BARRIDA O RECHAZO"
                    ev := 1
                    f_tag(bar_index, upper ? high : low, SYM_LVL, "NIVEL ALCANZADO · " + ename, cLvl, not upper)

            // ============ fase 2 · esperando la ruptura ======================
            else if s.phase == 2
                // s.ext NO se actualiza aquí: sigue congelado desde la vela de
                // detección (ver el arranque de secuencia).
                broke = upper ? close < s.structLvl - tol : close > s.structLvl + tol
                if broke
                    // Zona de retesteo acotada por maxRetest: una vela de
                    // desplazamiento enorme no puede convertir toda su amplitud
                    // en zona válida.
                    if upper
                        s.zLo := s.structLvl - tol
                        s.zHi := math.min(math.max(high, s.structLvl + tol), s.zLo + maxRetest)
                    else
                        s.zHi := s.structLvl + tol
                        s.zLo := math.max(math.min(low, s.structLvl - tol), s.zHi - maxRetest)
                    if s.zHi <= s.zLo          // garantía de zona no degenerada
                        s.zHi := s.zLo + tick
                    s.phase    := 3
                    s.tBar     := bar_index
                    s.moved    := false
                    s.movedBar := -1
                    s.note     := "RUPTURA ESTRUCTURAL"
                    s.missing  := "FALTA RETESTEO"
                    ev := 4
                    f_box(bar_index, s.zHi, bar_index + i_maxBars, s.zLo, cNeu, 92)
                    f_tag(bar_index, upper ? low : high, SYM_BOS, "RUPTURA ESTRUCTURAL", cNeu, upper)

            // ============ fase 3 · esperando el retesteo =====================
            else if s.phase == 3
                despl = upper ? low <= s.zLo - disp : high >= s.zHi + disp
                if not s.moved and despl
                    s.moved    := true
                    s.movedBar := bar_index
                    s.note     := "ESPERANDO RETESTEO"
                    ev := 5
                vuelve = upper ? high >= s.zLo : low <= s.zHi
                // El retesteo sólo puede observarse en una vela POSTERIOR a la
                // que confirmó el desplazamiento mínimo.
                if s.moved and vuelve and bar_index > s.movedBar
                    s.phase   := 4
                    s.tBar    := bar_index
                    s.note    := "RETESTEO EN OBSERVACIÓN"
                    s.missing := "FALTA RECHAZO DEL RETESTEO"
                    ev := 6
                    f_tag(bar_index, upper ? high : low, SYM_RET, "RETESTEO EN OBSERVACIÓN", cNeu, not upper)

            // ============ fase 5 · seguimiento de la estructura ==============
            else if s.phase == 5
                lleg1R = upper ? low <= s.refPx - s.dist : high >= s.refPx + s.dist
                if not s.r1 and not na(s.dist) and lleg1R
                    s.r1 := true
                    f_tag(bar_index, upper ? low : high, SYM_R1, "REFERENCIA 1R ALCANZADA", cOk, upper)

            // ============ fase 4 · ¿el retesteo falla? =======================
            // (fuera de la cadena: puede confirmarse en la misma vela del retesteo)
            if s.phase == 4
                inZone = upper ? high >= s.zLo : low <= s.zHi
                rejU   = close < s.zLo and (close < open or wickUp >= i_wick)
                rejD   = close > s.zHi and (close > open or wickDn >= i_wick)
                if inZone and (upper ? rejU : rejD)
                    ctxNow  = upper ? ctxUp : ctxDn
                    repetid = not na(s.doneLvl) and math.abs(s.doneLvl - s.lvl) <= i_sameLvlPts
                    s.phase   := 5
                    s.tBar    := bar_index
                    s.refPx   := close                                  // referencia estructural neutral
                    s.invPx   := upper ? s.ext + tol : s.ext - tol       // desde el extremo CONGELADO
                    s.dist    := math.abs(s.invPx - s.refPx)             // distancia de invalidación
                    s.ctxDone := ctxNow
                    s.note    := ctxNow == 2 ? "ESTRUCTURA A+" : "ESTRUCTURA COMPLETA"
                    s.missing := ""
                    s.doneLvl := s.lvl
                    s.r1      := false
                    if s.fails >= i_maxFails
                        s.warn := "PAUSA Y ESPERAR NUEVA ESTRUCTURA"
                    else if repetid
                        s.warn := "ESTRUCTURA REPETIDA EN EL MISMO NIVEL"
                    ev := 7
                    cDone = ctxNow == 2 ? cOk : cNeu
                    txt   = s.note + " · " + s.lvlName + "\n" + f_ctxTxt(ctxNow)
                    f_tag(bar_index, upper ? low : high, ctxNow == 2 ? SYM_APLUS : SYM_DONE, txt, cDone, upper)
                    dTxt = str.tostring(s.dist, format.mintick) + " pts / " + str.tostring(int(math.round(s.dist / tick))) + " ticks"
                    f_ref(s.invPx, SYM_INV + " " + str.tostring(s.dist, format.mintick), "INVALIDACIÓN ESTRUCTURAL · DISTANCIA DE INVALIDACIÓN " + dTxt, cWarn, false)
                    f_ref(s.refPx, SYM_DONE, "REFERENCIA ESTRUCTURAL", cDone, true)
                    if i_showRefs
                        r1px = upper ? s.refPx - s.dist     : s.refPx + s.dist
                        r2px = upper ? s.refPx - 2 * s.dist : s.refPx + 2 * s.dist
                        f_ref(r1px, "1R", "REFERENCIA 1R", cDone, true)
                        f_ref(r2px, "2R", "REFERENCIA 2R", cDone, true)
                    if s.dist < minInvEff
                        f_tag(bar_index, upper ? high : low, SYM_WARN, "INVALIDACIÓN DEMASIADO CERCANA AL RUIDO", cWarn, not upper)
    ev

evUp = f_step(seqUp, true,  evtUp, lvlUpP, lvlUpN)
evDn = f_step(seqDn, false, evtDn, lvlDnP, lvlDnN)

// =============================================================================
// 8 · NIVELES, FILTROS Y SESIÓN EN EL GRÁFICO
// =============================================================================
plot(i_showON  ? onH    : na, "ON High",     color = color.new(cLvl, 35), style = plot.style_linebr)
plot(i_showON  ? onL    : na, "ON Low",      color = color.new(cLvl, 35), style = plot.style_linebr)
plot(i_showPD  ? pdH    : na, "PDH",         color = color.new(cLvl, 55), style = plot.style_linebr)
plot(i_showPD  ? pdL    : na, "PDL",         color = color.new(cLvl, 55), style = plot.style_linebr)
plot(i_showOR  ? orH    : na, "OR High",     color = color.new(cNeu, 40), style = plot.style_linebr)
plot(i_showOR  ? orL    : na, "OR Low",      color = color.new(cNeu, 40), style = plot.style_linebr)
plot(i_showPiv ? lastPH : na, "Pivote alto", color = color.new(cLvl, 72), style = plot.style_linebr)
plot(i_showPiv ? lastPL : na, "Pivote bajo", color = color.new(cLvl, 72), style = plot.style_linebr)
plot(i_useEma  ? emaLoc  : na, "EMA local", color = color.new(cNeu, 50))
plot(i_useVwap ? vwapVal : na, "VWAP",      color = color.new(#ff9800, 40))
bgcolor(inRTH ? color.new(cNeu, 96) : na, title = "Sesión regular")

// --- etiquetas de nivel en la última vela -----------------------------------
var array<label> lvlTags = array.new<label>()
if barstate.islast and i_lvlTags
    while array.size(lvlTags) > 0
        label.delete(array.shift(lvlTags))
    if array.size(lvlP) > 0
        for i = 0 to array.size(lvlP) - 1
            lb = label.new(bar_index + 2, array.get(lvlP, i), array.get(lvlN, i),
                 style = label.style_label_left, color = color.new(cLvl, 85),
                 textcolor = color.new(cLvl, 0), size = size.tiny)
            array.push(lvlTags, lb)

// =============================================================================
// 9 · PANEL DE ESTADO
// =============================================================================
f_phaseTxt(Seq s) =>
    switch s.phase
        0 => s.note == "" ? "SIN SECUENCIA" : s.note
        1 => "NIVEL ALCANZADO · " + s.lvlName
        2 => s.note + " · " + s.lvlName
        3 => s.moved ? "ESPERANDO RETESTEO" : "RUPTURA ESTRUCTURAL"
        4 => "RETESTEO EN OBSERVACIÓN"
        5 => s.note
        => "—"

f_phaseCol(Seq s) =>
    switch s.phase
        0 => s.note == "ESTRUCTURA INVALIDADA" ? cOff : cLvl
        1 => cLvl
        2 => cWarn
        3 => cNeu
        4 => cNeu
        5 => s.ctxDone == 2 ? cOk : cNeu
        => cLvl

f_gradeTxt(Seq s) =>
    s.phase == 5 ? (s.ctxDone == 2 ? "ESTRUCTURA A+" : "ESTRUCTURA CONFIRMADA") : s.phase >= 2 ? "ESTRUCTURA ANTICIPADA" : "—"

f_missTxt(Seq s) =>
    string out = "—"
    if s.phase >= 1 and s.phase < 5
        out := s.missing == "" ? "ESTRUCTURA INCOMPLETA" : "ESTRUCTURA INCOMPLETA · " + s.missing
    out

f_distTxt(Seq s) =>
    string out = "—"
    if s.phase == 5 and not na(s.dist)
        out := str.tostring(s.dist, format.mintick) + " pts / " + str.tostring(int(math.round(s.dist / tick))) + " ticks"
        if s.dist < minInvEff
            out := out + "  ⚠ DEMASIADO CERCANA AL RUIDO"
    out

f_warnTxt(Seq s) =>
    string out = "—"
    if s.warn != ""
        out := s.warn
    else if s.r1 and s.phase < 5
        out := "NO HAY NUEVA CONFIRMACIÓN ESTRUCTURAL"
    out

f_lvlTxt(Seq s) =>
    string out = "—"
    if s.phase > 0 and not na(s.lvl)
        out := s.lvlName + "  " + str.tostring(s.lvl, format.mintick)
    out

f_strTxt(b) => b == 1 ? "ASCENDENTE" : b == -1 ? "DESCENDENTE" : "MIXTA"

// --- lectura compacta: glifo, palabra corta y progreso en puntos -------------
f_dots(int ph) =>
    int n = math.max(0, math.min(5, ph))
    string out = ""
    for k = 1 to 5
        out := out + (k <= n ? SYM_DONE : SYM_OFF)
    out

f_phSym(Seq s) =>
    switch s.phase
        0 => s.note == "ESTRUCTURA INVALIDADA" ? SYM_INV : SYM_OFF
        1 => SYM_LVL
        2 => s.note == "RECHAZO DETECTADO" ? SYM_REJ : SYM_SWEEP
        3 => s.moved ? SYM_WAIT : SYM_BOS
        4 => SYM_RET
        5 => s.ctxDone == 2 ? SYM_APLUS : SYM_DONE
        => SYM_OFF

f_phShort(Seq s) =>
    switch s.phase
        0 => s.note == "ESTRUCTURA INVALIDADA" ? "INVALIDADA" : s.note == "SECUENCIA EXPIRADA" ? "EXPIRADA" : "—"
        1 => "NIVEL"
        2 => s.note == "RECHAZO DETECTADO" ? "RECHAZO" : "BARRIDA"
        3 => s.moved ? "ESPERA" : "RUPTURA"
        4 => "RETESTEO"
        5 => s.ctxDone == 2 ? "A+" : "COMPLETA"
        => "—"

f_ctxSym(st)   => st == 2 ? "✓" : st == 0 ? "✕" : "~"
f_ctxShort(st) => st == 2 ? "ALINEADO" : st == 0 ? "CONTRARIO" : "MIXTO"

f_warnShort(Seq s) =>
    string out = "—"
    if s.warn != ""
        out := str.contains(s.warn, "PAUSA")   ? SYM_PAUSE + " PAUSA"
             : str.contains(s.warn, "SEGUNDA") ? SYM_WARN + " 2ª FALLA"
             : SYM_WARN + " REPETIDA"
    else if s.r1 and s.phase < 5
        out := "◌ SIN NUEVA"
    out

f_warnGlyph(Seq s) =>
    string out = "·"
    if s.warn != ""
        out := str.contains(s.warn, "PAUSA") ? SYM_PAUSE : SYM_WARN
    else if s.r1 and s.phase < 5
        out := "◌"
    out

f_distShort(Seq s) =>
    string out = "—"
    if s.phase == 5 and not na(s.dist)
        out := str.tostring(s.dist, format.mintick) + (s.dist < minInvEff ? "  " + SYM_WARN : "")
    out

// --- panel -------------------------------------------------------------------
var table panel = table.new(position.top_right, 3, 10, border_width = 1, frame_width = 1,
     frame_color = color.new(#787b86, 70), border_color = color.new(#787b86, 88))

f_cellS(int col, int row, string txt, color bg, color tc, string tip) =>
    table.cell(panel, col, row, txt, text_size = size.tiny,
         text_halign = text.align_left, bgcolor = bg, text_color = tc, tooltip = tip)

f_cellT(int col, int row, string txt, color bg, color tc, string tip) =>
    table.cell(panel, col, row, txt, text_size = size.small,
         text_halign = text.align_left, bgcolor = bg, text_color = tc, tooltip = tip)

f_cellB(int col, int row, string txt, color bg, color tc, string tip) =>
    table.cell(panel, col, row, txt, text_size = size.normal,
         text_halign = text.align_left, bgcolor = bg, text_color = tc, tooltip = tip)

// Un único punto de escritura: el tamaño lo decide el input, no cada llamada.
f_put(int col, int row, string txt, color bg, color tc, string tip) =>
    if i_panelSize == "Pequeño"
        f_cellS(col, row, txt, bg, tc, tip)
    else if i_panelSize == "Grande"
        f_cellB(col, row, txt, bg, tc, tip)
    else
        f_cellT(col, row, txt, bg, tc, tip)

f_cell(int col, int row, string txt, color bg, color tc) =>
    f_put(col, row, txt, bg, tc, "")

f_posSel(string p) =>
    switch p
        "Superior izquierda" => position.top_left
        "Superior centro"    => position.top_center
        "Superior derecha"   => position.top_right
        "Centro izquierda"   => position.middle_left
        "Centro derecha"     => position.middle_right
        "Inferior izquierda" => position.bottom_left
        "Inferior centro"    => position.bottom_center
        "Inferior derecha"   => position.bottom_right
        => position.top_right

if i_showTable and barstate.islast
    bgHdr = color.new(#1b1f27, 10)
    bgRow = color.new(#12151b, 20)
    cHdr  = color.new(color.white, 20)
    cKey  = color.new(color.white, 45)
    ruidoUp = seqUp.phase == 5 and nz(seqUp.dist, 999) < minInvEff
    ruidoDn = seqDn.phase == 5 and nz(seqDn.dist, 999) < minInvEff
    perfTip = "Perfil " + profUsed + (i_profile == "Auto" ? " (auto)" : "") + " · raíz " + rootU +
       "\ntolerancia " + str.tostring(tolTicksEff) + " ticks · desplazamiento " + str.tostring(dispTicksEff) +
       " ticks\nzona de retesteo " + str.tostring(retestTicksEff) + " ticks · invalidación mínima " +
       str.tostring(minInvEff) + " puntos"
    tipUp = f_phaseTxt(seqUp) + "\n" + f_missTxt(seqUp)
    tipDn = f_phaseTxt(seqDn) + "\n" + f_missTxt(seqDn)

    // se limpia siempre para que al cambiar de modo no queden celdas viejas
    table.clear(panel, 0, 0, 2, 9)
    table.set_position(panel, f_posSel(i_panelPos))

    if i_panelMode == "Móvil"
        // ---------- panel móvil: dos columnas, glifos, sin etiquetas ---------
        //   Todo el texto largo sigue disponible en el tooltip de cada celda.
        f_put(0, 0, "SUP", bgHdr, cHdr, "Secuencia nacida de una barrida por arriba" + "\n" + perfTip)
        f_put(1, 0, "INF", bgHdr, cHdr, "Secuencia nacida de una barrida por abajo" + "\n" + perfTip)

        f_put(0, 1, f_dots(seqUp.phase) + " " + f_phSym(seqUp), bgRow, f_phaseCol(seqUp), tipUp)
        f_put(1, 1, f_dots(seqDn.phase) + " " + f_phSym(seqDn), bgRow, f_phaseCol(seqDn), tipDn)

        f_put(0, 2, f_ctxSym(ctxUp), bgRow, f_ctxCol(ctxUp), f_ctxTxt(ctxUp))
        f_put(1, 2, f_ctxSym(ctxDn), bgRow, f_ctxCol(ctxDn), f_ctxTxt(ctxDn))

        f_put(0, 3, f_distShort(seqUp), bgRow, ruidoUp ? cWarn : cLvl, f_distTxt(seqUp))
        f_put(1, 3, f_distShort(seqDn), bgRow, ruidoDn ? cWarn : cLvl, f_distTxt(seqDn))

        f_put(0, 4, f_warnGlyph(seqUp), bgRow, cWarn, f_warnTxt(seqUp))
        f_put(1, 4, f_warnGlyph(seqDn), bgRow, cWarn, f_warnTxt(seqDn))
    else if i_panelMode == "Compacto"
        // ---------- panel compacto: 5 filas, glifos y una palabra ------------
        f_put(0, 0, "◧", bgHdr, cHdr, perfTip)
        f_put(1, 0, "SUPERIOR", bgHdr, cHdr, "Secuencia nacida de una barrida por arriba")
        f_put(2, 0, "INFERIOR", bgHdr, cHdr, "Secuencia nacida de una barrida por abajo")

        f_put(0, 1, "FASE", bgRow, cKey, "Progreso de la secuencia: nivel · barrida · ruptura · retesteo · completa")
        f_put(1, 1, f_dots(seqUp.phase) + " " + f_phSym(seqUp) + " " + f_phShort(seqUp), bgRow, f_phaseCol(seqUp), tipUp)
        f_put(2, 1, f_dots(seqDn.phase) + " " + f_phSym(seqDn) + " " + f_phShort(seqDn), bgRow, f_phaseCol(seqDn), tipDn)

        f_put(0, 2, "CTX", bgRow, cKey, "EMA, VWAP, EMA HTF, estructura HTF y espacio hasta el próximo nivel")
        f_put(1, 2, f_ctxSym(ctxUp) + " " + f_ctxShort(ctxUp), bgRow, f_ctxCol(ctxUp), f_ctxTxt(ctxUp))
        f_put(2, 2, f_ctxSym(ctxDn) + " " + f_ctxShort(ctxDn), bgRow, f_ctxCol(ctxDn), f_ctxTxt(ctxDn))

        f_put(0, 3, "INVAL", bgRow, cKey, "DISTANCIA DE INVALIDACIÓN en puntos")
        f_put(1, 3, f_distShort(seqUp), bgRow, ruidoUp ? cWarn : cLvl, f_distTxt(seqUp))
        f_put(2, 3, f_distShort(seqDn), bgRow, ruidoDn ? cWarn : cLvl, f_distTxt(seqDn))

        f_put(0, 4, "AVISO", bgRow, cKey, "Control de repetición y de estructuras ya explotadas")
        f_put(1, 4, f_warnShort(seqUp), bgRow, cWarn, f_warnTxt(seqUp))
        f_put(2, 4, f_warnShort(seqDn), bgRow, cWarn, f_warnTxt(seqDn))
    else
        // ---------- panel detallado ------------------------------------------
        f_cell(0, 0, "LECTOR ESTRUCTURAL", bgHdr, cHdr)
        f_cell(1, 0, "BARRIDA SUPERIOR",   bgHdr, cHdr)
        f_cell(2, 0, "BARRIDA INFERIOR",   bgHdr, cHdr)

        f_cell(0, 1, "Fase",            bgRow, cKey)
        f_cell(1, 1, f_phaseTxt(seqUp), bgRow, f_phaseCol(seqUp))
        f_cell(2, 1, f_phaseTxt(seqDn), bgRow, f_phaseCol(seqDn))

        f_cell(0, 2, "Estado",         bgRow, cKey)
        f_cell(1, 2, f_missTxt(seqUp), bgRow, seqUp.phase == 5 ? cOk : cWarn)
        f_cell(2, 2, f_missTxt(seqDn), bgRow, seqDn.phase == 5 ? cOk : cWarn)

        f_cell(0, 3, "Clasificación",   bgRow, cKey)
        f_cell(1, 3, f_gradeTxt(seqUp), bgRow, f_phaseCol(seqUp))
        f_cell(2, 3, f_gradeTxt(seqDn), bgRow, f_phaseCol(seqDn))

        f_cell(0, 4, "Contexto",      bgRow, cKey)
        f_cell(1, 4, f_ctxTxt(ctxUp), bgRow, f_ctxCol(ctxUp))
        f_cell(2, 4, f_ctxTxt(ctxDn), bgRow, f_ctxCol(ctxDn))

        f_cell(0, 5, "Nivel",         bgRow, cKey)
        f_cell(1, 5, f_lvlTxt(seqUp), bgRow, cLvl)
        f_cell(2, 5, f_lvlTxt(seqDn), bgRow, cLvl)

        f_cell(0, 6, "DISTANCIA DE INVALIDACIÓN", bgRow, cKey)
        f_cell(1, 6, f_distTxt(seqUp), bgRow, ruidoUp ? cWarn : cLvl)
        f_cell(2, 6, f_distTxt(seqDn), bgRow, ruidoDn ? cWarn : cLvl)

        f_cell(0, 7, "Aviso",          bgRow, cKey)
        f_cell(1, 7, f_warnTxt(seqUp), bgRow, cWarn)
        f_cell(2, 7, f_warnTxt(seqDn), bgRow, cWarn)

        f_cell(0, 8, "Estructura",                   bgRow, cKey)
        f_cell(1, 8, "HTF " + i_htf + ": " + f_strTxt(htfStruct), bgRow, cNeu)
        f_cell(2, 8, "Local: " + f_strTxt(locStruct), bgRow, cNeu)

        f_put(0, 9, "Perfil", bgRow, cKey, perfTip)
        f_put(1, 9, profUsed + (i_profile == "Auto" ? " (auto)" : "") + " · " + rootU, bgRow, cNeu, perfTip)
        f_put(2, 9, "tol " + str.tostring(tolTicksEff) + "t · desp " + str.tostring(dispTicksEff) + "t · zona " + str.tostring(retestTicksEff) + "t · inval " + str.tostring(minInvEff) + " pts", bgRow, cLvl, perfTip)

// =============================================================================
// 10 · ALERTAS · sólo cambios de estado estructural, sin lenguaje operativo
// =============================================================================
alNivel     = evUp == 1 or evDn == 1
alBarrida   = evUp == 2 or evDn == 2
alRechazo   = evUp == 3 or evDn == 3
alRuptura   = evUp == 4 or evDn == 4
alEsperando = evUp == 5 or evDn == 5
alRetesteo  = evUp == 6 or evDn == 6
alCompleta  = evUp == 7 or evDn == 7
alAplus     = (evUp == 7 and seqUp.ctxDone == 2) or (evDn == 7 and seqDn.ctxDone == 2)
alInvalida  = evUp == 8 or evDn == 8
alRuido     = (evUp == 7 and nz(seqUp.dist, 999) < minInvEff) or (evDn == 7 and nz(seqDn.dist, 999) < minInvEff)
alPausa     = (evUp == 8 and seqUp.fails >= i_maxFails) or (evDn == 8 and seqDn.fails >= i_maxFails)

alertcondition(alNivel,     "NIVEL ALCANZADO",                  "Estructura: el precio alcanzó un nivel de referencia")
alertcondition(alBarrida,   "POSIBLE BARRIDA",                  "Estructura: posible barrida de liquidez en el nivel")
alertcondition(alRechazo,   "RECHAZO DETECTADO",                "Estructura: rechazo confirmado en el nivel")
alertcondition(alRuptura,   "RUPTURA ESTRUCTURAL",              "Estructura: ruptura confirmada del extremo del pullback")
alertcondition(alEsperando, "ESPERANDO RETESTEO",               "Estructura: desplazamiento confirmado, falta el retesteo")
alertcondition(alRetesteo,  "RETESTEO EN OBSERVACIÓN",          "Estructura: el precio regresó a la zona de ruptura")
alertcondition(alCompleta,  "ESTRUCTURA COMPLETA",              "Estructura: secuencia completa con retesteo rechazado")
alertcondition(alAplus,     "ESTRUCTURA A+",                    "Estructura: secuencia completa con contexto alineado")
alertcondition(alInvalida,  "ESTRUCTURA INVALIDADA",            "Estructura: se perdió el extremo de la barrida")
alertcondition(alRuido,     "INVALIDACIÓN DEMASIADO CERCANA",   "Estructura: la distancia de invalidación queda dentro del ruido")
alertcondition(alPausa,     "PAUSA Y ESPERAR NUEVA ESTRUCTURA", "Estructura: fallas repetidas en la misma zona")
