//@version=6
// ===================================================================
//  SMC CONFLUENCE MASTER v2 - BACKTEST (Pine Script v6)
//  VERSION DEFINITIVA TODO-EN-UNO: backtest en el Probador + alertas
//  en vivo con alert() en las entradas (mismas operaciones exactas).
//  Comision 2.5 USD por contrato y lado, slippage 1 tick.
//  Sweep + MSS/CHoCH + FVG + Sesion + HTF + VWAP + Volumen + SMT + EQH/EQL
//  Disenado para ES / NQ en 15m y 1H (tambien funciona en 1m-5m).
//  Archivo 100% ASCII para evitar problemas de codificacion al copiar.
//
//  COMO USARLO:
//  1) TradingView -> Editor Pine -> pega todo -> "Anadir al grafico".
//  2) Usalo en 15m o 1H. El TF mayor se ajusta solo (15m->1H, 1H->4H).
//  3) La senal sigue el modelo completo en 3 pasos:
//       PASO 1  Barrido de liquidez (swing/EQH/EQL con rechazo)
//       PASO 2  MSS/CHoCH: el precio rompe la estructura menor en contra
//               del barrido (confirma que fue sweep y no continuacion)
//       PASO 3  Entrada al confirmar el MSS (opcional: exigir ademas
//               el retorno al FVG, modo estricto, en el grupo 8)
//     Todo dentro de tu ventana horaria y con score de confluencia minimo.
//  4) Alertas: "Crear alerta" -> condicion: este indicador ->
//     "Cualquier funcion alert()" para recibir el mensaje con E/SL/TP.
//
//  SCORE (max 7): 2 (barrido) + HTF + VWAP + Volumen + SMT + EQH/EQL.
//  Si un filtro esta apagado no penaliza. EQH/EQL es bonus.
//
//  MODO DE RIESGO (grupo 8b):
//  - "ATR (estructura)": SL en el extremo del barrido, TP por multiplos de R.
//  - "USD fijo": perdida maxima y objetivo en dolares (usa el valor del
//    punto del contrato y el numero de contratos). Con el filtro activado
//    solo entra cuando el SL estructural cabe en la perdida maxima.
//
//  ANTI-REPINTADO:
//  - Senales solo al cierre de vela (barstate.isconfirmed).
//  - Sesgo HTF con vela HTF CERRADA (idiom [1] + lookahead_on).
//  - Pivotes confirmados con retardo fijo, nunca se redibujan.
// ===================================================================
strategy("SMC Confluence Master v2 Backtest", "SMC BT",
     overlay=true, initial_capital=25000,
     margin_long=0, margin_short=0,
     commission_type=strategy.commission.cash_per_contract,
     commission_value=2.5, slippage=1,
     process_orders_on_close=true, fill_orders_on_standard_ohlc=true,
     max_boxes_count=300, max_labels_count=300, max_lines_count=300)

// ========== 1) FILTRO HORARIO (America/Chicago) ==========
grpS = "1) Filtro horario (hora CT)"
useSes   = input.bool(true,  "Senales solo en sesiones activas", group=grpS)
sesNY    = input.session("0730-1400", "Sesion NY AM (tu ventana)", group=grpS)
useLDN   = input.bool(false, "Incluir Londres", group=grpS)
sesLDN   = input.session("0200-0500", "Sesion Londres", group=grpS)
avoidLun = input.bool(true,  "Bloquear mediodia (lunch)", group=grpS)
sesLUN   = input.session("1130-1300", "Lunch NY", group=grpS)
tzStr    = input.string("America/Chicago", "Zona horaria", group=grpS)
showBg   = input.bool(true, "Sombrear sesiones", group=grpS)

// Filtro de noticias: ventanas de reloj fijo donde NO se abren entradas
// (posiciones ya abiertas siguen su curso con su stop). APAGADO por defecto
// para no alterar el sistema validado; activalo y mide en el Probador.
grpN = "1b) Filtro de noticias (hora CT)"
useNews = input.bool(false, "Bloquear ventanas de noticias", group=grpN)
news1   = input.session("0725-0735", "Ventana 1: datos de las 8:30 ET", group=grpN)
news2   = input.session("0855-0905", "Ventana 2: datos de las 10:00 ET", group=grpN)
news3   = input.session("1255-1305", "Ventana 3: FOMC (dias de Fed)", group=grpN)

inNY  = not na(time(timeframe.period, sesNY, tzStr))
inLDN = not na(time(timeframe.period, sesLDN, tzStr))
inLUN = not na(time(timeframe.period, sesLUN, tzStr))
inN1 = not na(time(timeframe.period, news1, tzStr))
inN2 = not na(time(timeframe.period, news2, tzStr))
inN3 = not na(time(timeframe.period, news3, tzStr))
inNews = useNews and (inN1 or inN2 or inN3)
sesionOK = (not useSes or inNY or (useLDN and inLDN)) and not (avoidLun and inLUN) and not inNews

bgcolor(showBg and inNY ? color.new(color.teal, 93) : na, title="Fondo NY")
bgcolor(showBg and useLDN and inLDN ? color.new(color.blue, 94) : na, title="Fondo Londres")
bgcolor(showBg and avoidLun and inLUN ? color.new(color.gray, 92) : na, title="Fondo lunch")
bgcolor(showBg and inNews ? color.new(color.red, 88) : na, title="Fondo noticias")

// ========== 2) SESGO: TF MAYOR + VWAP ==========
grpB = "2) Sesgo (TF mayor + VWAP)"
useHTF  = input.bool(true, "Filtrar con sesgo del TF mayor", group=grpB)
autoHTF = input.bool(true, "TF mayor automatico (15m->1H, 1H->4H)", group=grpB)
htfTF   = input.timeframe("60", "TF mayor manual", group=grpB)
htfLen  = input.int(50, "EMA del TF mayor", minval=5, group=grpB)
useVW   = input.bool(false, "Filtrar con VWAP de sesion", group=grpB)
showVW  = input.bool(true, "Mostrar VWAP", group=grpB)

tfSec   = timeframe.in_seconds()
htfAuto = tfSec <= 900 ? "60" : tfSec <= 3600 ? "240" : "D"
htfUse  = autoHTF ? htfAuto : htfTF
// Vela HTF cerrada -> no repinta mientras la vela del TF mayor esta abierta
htfSrc = ta.ema(close, htfLen)
htfEma = request.security(syminfo.tickerid, htfUse, htfSrc[1], lookahead=barmerge.lookahead_on)
htfValido = tfSec < timeframe.in_seconds(htfUse)
htfBull = close > htfEma
htfBear = close < htfEma

vwapVal = ta.vwap(hlc3)
vwBull  = close > vwapVal
vwBear  = close < vwapVal
plot(showVW ? vwapVal : na, "VWAP sesion", color=color.new(color.orange, 0), linewidth=2)

// ========== 3) SWINGS Y BARRIDO DE LIQUIDEZ ==========
grpP = "3) Barrido de liquidez"
pivLen = input.int(4, "Longitud de pivote (swings)", minval=2, group=grpP)
eqTolA = input.float(0.25, "Tolerancia EQH/EQL (x ATR)", step=0.05, group=grpP)
wickA  = input.float(0.5, "Mecha minima de rechazo (x ATR)", step=0.1, group=grpP)
allow2 = input.bool(false, "Permitir barrido en 2 velas", group=grpP)
showSw = input.bool(true, "Mostrar ultimos swings", group=grpP)

atr = ta.atr(14)
ph  = ta.pivothigh(high, pivLen, pivLen)
plv = ta.pivotlow(low, pivLen, pivLen)

var float lastPH = na
var float prevPH = na
var float lastPL = na
var float prevPL = na
if not na(ph)
    prevPH := lastPH
    lastPH := ph
if not na(plv)
    prevPL := lastPL
    lastPL := plv

eqhDiff = math.abs(lastPH - prevPH)
eqlDiff = math.abs(lastPL - prevPL)
eqhTag = not na(lastPH) and not na(prevPH) and eqhDiff <= eqTolA * atr
eqlTag = not na(lastPL) and not na(prevPL) and eqlDiff <= eqTolA * atr

// Cada swing es un segmento FIJO: nace en su pivote, se extiende hasta
// que lo barren y ahi se queda quieto (solo visual, no toca la logica)
colPhLn = color.new(color.red, 45)
colPlLn = color.new(color.green, 45)
var line phLine = na
var line plLine = na
if showSw and not na(ph) and barstate.isconfirmed
    phLine := line.new(bar_index - pivLen, ph, bar_index, ph, color=colPhLn)
if showSw and not na(plv) and barstate.isconfirmed
    plLine := line.new(bar_index - pivLen, plv, bar_index, plv, color=colPlLn)
if not na(phLine)
    line.set_x2(phLine, bar_index)
if not na(plLine)
    line.set_x2(plLine, bar_index)

upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
wickBearOK = upperWick >= wickA * atr
wickBullOK = lowerWick >= wickA * atr

// Sweep 1 vela: toma el nivel con mecha y CIERRA de vuelta dentro
sweepBear1 = not na(lastPH) and high > lastPH and close < lastPH and wickBearOK
sweepBull1 = not na(lastPL) and low < lastPL and close > lastPL and wickBullOK
// Sweep 2 velas: la anterior rompe y cierra fuera, esta cierra de vuelta dentro
sweepBear2a = allow2 and not na(lastPH) and high[1] > lastPH
sweepBear2  = sweepBear2a and close[1] >= lastPH and close < lastPH
sweepBull2a = allow2 and not na(lastPL) and low[1] < lastPL
sweepBull2  = sweepBull2a and close[1] <= lastPL and close > lastPL
sweepBear = sweepBear1 or sweepBear2
sweepBull = sweepBull1 or sweepBull2

// El nivel barrido deja de extenderse y queda fijo donde fue tomado
if sweepBear and barstate.isconfirmed
    phLine := na
if sweepBull and barstate.isconfirmed
    plLine := na

colSwBear = color.new(color.red, 20)
colSwBull = color.new(color.green, 20)
plotshape(sweepBear, title="Barrido de high", style=shape.triangledown,
     location=location.abovebar, color=colSwBear, size=size.tiny)
plotshape(sweepBull, title="Barrido de low", style=shape.triangleup,
     location=location.belowbar, color=colSwBull, size=size.tiny)

// ========== 4) SMT (divergencia con simbolo correlacionado) ==========
grpM = "4) SMT (ES <-> NQ)"
useSMT  = input.bool(true, "Usar SMT como confluencia", group=grpM)
corrSym = input.symbol("CME_MINI:NQ1!", "Simbolo correlacionado", group=grpM)

corrH = request.security(corrSym, timeframe.period, high, lookahead=barmerge.lookahead_off)
corrL = request.security(corrSym, timeframe.period, low, lookahead=barmerge.lookahead_off)
corrOK = not na(corrH) and not na(corrL)
cph  = ta.pivothigh(corrH, pivLen, pivLen)
cplv = ta.pivotlow(corrL, pivLen, pivLen)
var float corrPH = na
var float corrPL = na
if not na(cph)
    corrPH := cph
if not na(cplv)
    corrPL := cplv

// SMT: tu simbolo barre su nivel pero el correlacionado NO barre el suyo
smtBearNow = useSMT and sweepBear and corrOK and not na(corrPH) and corrH < corrPH
smtBullNow = useSMT and sweepBull and corrOK and not na(corrPL) and corrL > corrPL

// ========== 5) VOLUMEN ==========
grpV = "5) Volumen"
useVol  = input.bool(false, "Usar volumen como confluencia", group=grpV)
volLen  = input.int(20, "Media de volumen", group=grpV)
volMult = input.float(1.3, "Volumen minimo del barrido (x media)", step=0.1, group=grpV)
volSma  = ta.sma(nz(volume), volLen)
volOKn  = nz(volume) >= volSma * volMult
volOKp  = nz(volume[1]) >= volSma[1] * volMult

// ========== 6) FVG (zona de entrada) ==========
grpF = "6) FVG"
showFVG = input.bool(true, "Dibujar FVGs", group=grpF)
fvgMinA = input.float(0.15, "Tamano minimo del FVG (x ATR)", step=0.05, group=grpF)

bullFVG = low > high[2] and (low - high[2]) >= fvgMinA * atr
bearFVG = high < low[2] and (low[2] - high) >= fvgMinA * atr

fvgUpBor = color.new(color.green, 60)
fvgUpBg  = color.new(color.green, 88)
fvgDnBor = color.new(color.red, 60)
fvgDnBg  = color.new(color.red, 88)
fvgOffBor = color.new(color.gray, 75)
fvgOffBg  = color.new(color.gray, 93)

var float bullFvgTop = na
var float bullFvgBot = na
var int   bullFvgBar = na
var float bearFvgTop = na
var float bearFvgBot = na
var int   bearFvgBar = na
var box   bullBoxA = na
var box   bearBoxA = na

if bullFVG
    bullFvgTop := low
    bullFvgBot := high[2]
    bullFvgBar := bar_index
    if showFVG
        bullBoxA := box.new(bar_index - 2, low, bar_index, high[2], border_color=fvgUpBor, bgcolor=fvgUpBg)
if bearFVG
    bearFvgTop := low[2]
    bearFvgBot := high
    bearFvgBar := bar_index
    if showFVG
        bearBoxA := box.new(bar_index - 2, low[2], bar_index, high, border_color=fvgDnBor, bgcolor=fvgDnBg)

// El FVG activo se extiende hasta que el precio lo atraviesa por completo;
// entonces queda gris (invalidado) y deja de ser zona de entrada
if not na(bullBoxA) and not na(bullFvgBot)
    box.set_right(bullBoxA, bar_index)
if not na(bearBoxA) and not na(bearFvgTop)
    box.set_right(bearBoxA, bar_index)

if not na(bullFvgBot) and close < bullFvgBot
    bullFvgTop := na
    bullFvgBot := na
    bullFvgBar := na
    if not na(bullBoxA)
        box.set_border_color(bullBoxA, fvgOffBor)
        box.set_bgcolor(bullBoxA, fvgOffBg)
        bullBoxA := na
if not na(bearFvgTop) and close > bearFvgTop
    bearFvgTop := na
    bearFvgBot := na
    bearFvgBar := na
    if not na(bearBoxA)
        box.set_border_color(bearBoxA, fvgOffBor)
        box.set_bgcolor(bearBoxA, fvgOffBg)
        bearBoxA := na

inBullFvg = not na(bullFvgBot) and low <= bullFvgTop and close >= bullFvgBot
inBearFvg = not na(bearFvgTop) and high >= bearFvgBot and close <= bearFvgTop

// ========== 7) CONFIRMACION MSS / CHoCH ==========
grpC = "7) Confirmacion MSS (CHoCH)"
reqMSS  = input.bool(true, "Exigir MSS tras el barrido (recomendado)", group=grpC)
mssL    = input.int(2, "Longitud del pivote menor (estructura)", minval=2, group=grpC)
showMss = input.bool(true, "Marcar MSS en el grafico", group=grpC)

mph = ta.pivothigh(high, mssL, mssL)
mpl = ta.pivotlow(low, mssL, mssL)
var float minorPH = na
var float minorPL = na
if not na(mph)
    minorPH := mph
if not na(mpl)
    minorPL := mpl

// ========== 8) MAQUINA DE SETUP + SCORE ==========
grpX = "8) Senal y riesgo"
winBars  = input.int(7, "Ventana max. tras el barrido (velas)", minval=3, group=grpX)
reqFVG   = input.bool(false, "Exigir retorno a FVG para entrar (estricto)", group=grpX)
minScore = input.int(5, "Score minimo (max 7)", minval=2, maxval=7, group=grpX)
slBuf    = input.float(0.5, "Colchon del SL (x ATR)", step=0.1, group=grpX)
tp1R     = input.float(1.5, "TP1 (multiplo de R)", step=0.1, group=grpX)
tp2R     = input.float(2.5, "TP2 (multiplo de R)", step=0.1, group=grpX)
showZone = input.bool(true, "Pintar zonas verde/rojo de cada senal", group=grpX)

// Modo USD: SL y TP fijos en dolares segun el valor del punto del contrato.
// Con el filtro activado solo entra cuando el SL estructural (extremo del
// barrido + colchon) cabe dentro de la perdida maxima -> stop logico Y acotado.
grpR = "8b) Modo de riesgo"
modoSLTP = input.string("ATR (estructura)", "Modo de SL/TP", options=["ATR (estructura)", "USD fijo"], group=grpR)
qtyCt    = input.int(1, "Contratos", minval=1, group=grpR)
riskUSD  = input.float(400.0, "Perdida maxima (USD)", minval=1, group=grpR)
tgtUSD   = input.float(1000.0, "Objetivo de ganancia (USD)", minval=1, group=grpR)
fitStr   = input.bool(true, "Solo entrar si el SL estructural cabe en la perdida maxima", group=grpR)

// Laboratorio de mejoras: TODO apagado por defecto. Activa UNA por vez
// y mide en el Probador con rango de fechas fijo antes de adoptarla.
grpQ = "8c) Mejoras experimentales"
usePD   = input.bool(false, "Filtro Premium/Discount (shorts arriba, longs abajo)", group=grpQ)
pdLen   = input.int(120, "Velas del rango P/D", minval=20, group=grpQ)
useDisp = input.bool(false, "Exigir desplazamiento fuerte en el MSS", group=grpQ)
dispMin = input.float(0.6, "Cuerpo minimo de la vela MSS (x ATR)", step=0.1, group=grpQ)
// El BOS de continuacion es un MODULO INDEPENDIENTE: tiene su propio swing,
// su propio cuerpo minimo, su forma de entrada, su stop y sus objetivos.
// Nada aqui depende de la configuracion del sistema de reversion (barrido).
grpBOS = "8d) BOS de continuacion (modulo independiente)"
useBOS  = input.bool(false, "Activar BOS de continuacion", group=grpBOS)
bosPivLen = input.int(5, "Swing del BOS (pivote propio)", minval=2, group=grpBOS)
bosBody = input.float(0.3, "Cuerpo minimo del BOS (x ATR)", step=0.1, group=grpBOS)
bosWin  = input.int(10, "Ventana tras el BOS (velas)", minval=3, group=grpBOS)
bosReqFvg = input.bool(true, "Exigir retorno al FVG (si no: retest del nivel roto)", group=grpBOS)
bosScoreMin = input.int(4, "Factores que deben confirmar el BOS (max 6)", minval=2, maxval=6, group=grpBOS)
bosSlBuf = input.float(0.5, "Colchon del SL del BOS (x ATR)", step=0.1, group=grpBOS)
bosTp1R = input.float(1.5, "TP1 del BOS (multiplo de R)", step=0.1, group=grpBOS)
bosTp2R = input.float(2.5, "TP2 del BOS (multiplo de R)", step=0.1, group=grpBOS)
bosShow = input.bool(true, "Marcar la oportunidad BOS en el grafico", group=grpBOS)

var int   swBearBar = na
var float swBearExt = na
var float swBearMssLvl = na
var bool  swBearVol = false
var bool  swBearSMT = false
var bool  swBearEQ  = false
var bool  swBearMss = false
var bool  swBearDisp = false
var bool  bearFired = false

var int   swBullBar = na
var float swBullExt = na
var float swBullMssLvl = na
var bool  swBullVol = false
var bool  swBullSMT = false
var bool  swBullEQ  = false
var bool  swBullMss = false
var bool  swBullDisp = false
var bool  bullFired = false

var int lastBullSweepBar = na
var int lastBearSweepBar = na

// Expirar el setup si paso la ventana sin entrada
if not na(swBullBar) and (bar_index - swBullBar) > winBars
    swBullBar := na
    swBullMss := false
if not na(swBearBar) and (bar_index - swBearBar) > winBars
    swBearBar := na
    swBearMss := false

if sweepBear
    swBearBar := bar_index
    swBearExt := sweepBear2 ? math.max(high, high[1]) : high
    swBearVol := volOKn or (sweepBear2 and volOKp)
    swBearSMT := smtBearNow
    swBearEQ  := eqhTag
    swBearMss := false
    swBearDisp := false
    swBearMssLvl := na(minorPL) ? low : minorPL
    bearFired := false
    lastBearSweepBar := bar_index
if sweepBull
    swBullBar := bar_index
    swBullExt := sweepBull2 ? math.min(low, low[1]) : low
    swBullVol := volOKn or (sweepBull2 and volOKp)
    swBullSMT := smtBullNow
    swBullEQ  := eqlTag
    swBullMss := false
    swBullDisp := false
    swBullMssLvl := na(minorPH) ? high : minorPH
    bullFired := false
    lastBullSweepBar := bar_index

// MSS: tras barrer el low, el precio rompe al alza el ultimo swing menor
// (y viceversa). Es el CHoCH que separa un sweep real de una continuacion.
cMssUp = color.new(color.green, 55)
cMssDn = color.new(color.red, 55)
mssBullHit = not na(swBullBar) and not swBullMss and not na(swBullMssLvl) and close > swBullMssLvl
mssBearHit = not na(swBearBar) and not swBearMss and not na(swBearMssLvl) and close < swBearMssLvl
if mssBullHit
    swBullMss := true
    swBullDisp := math.abs(close - open) >= dispMin * atr
    if showMss and barstate.isconfirmed
        label.new(bar_index, high, "MSS", style=label.style_label_down, color=cMssUp, textcolor=color.white, size=size.tiny)
if mssBearHit
    swBearMss := true
    swBearDisp := math.abs(close - open) >= dispMin * atr
    if showMss and barstate.isconfirmed
        label.new(bar_index, low, "MSS", style=label.style_label_up, color=cMssDn, textcolor=color.white, size=size.tiny)

// Si un filtro esta apagado no penaliza el score. EQH/EQL es bonus.
sHtfB = not useHTF or htfBull ? 1 : 0
sVwB  = not useVW or vwBull ? 1 : 0
sVolB = not useVol or swBullVol ? 1 : 0
sSmtB = not useSMT or not corrOK or swBullSMT ? 1 : 0
scoreBull = 2 + sHtfB + sVwB + sVolB + sSmtB + (swBullEQ ? 1 : 0)

sHtfS = not useHTF or htfBear ? 1 : 0
sVwS  = not useVW or vwBear ? 1 : 0
sVolS = not useVol or swBearVol ? 1 : 0
sSmtS = not useSMT or not corrOK or swBearSMT ? 1 : 0
scoreBear = 2 + sHtfS + sVwS + sVolS + sSmtS + (swBearEQ ? 1 : 0)

winBull = not na(swBullBar) and (bar_index - swBullBar) <= winBars and not bullFired
winBear = not na(swBearBar) and (bar_index - swBearBar) <= winBars and not bearFired

fvgBullOK = inBullFvg and not na(bullFvgBar) and not na(swBullBar) and bullFvgBar >= swBullBar
fvgBearOK = inBearFvg and not na(bearFvgBar) and not na(swBearBar) and bearFvgBar >= swBearBar
entryBullTrig = not reqFVG or fvgBullOK
entryBearTrig = not reqFVG or fvgBearOK

mssBullOK = not reqMSS or swBullMss
mssBearOK = not reqMSS or swBearMss

usdMode = modoSLTP == "USD fijo"
pvQty   = syminfo.pointvalue * qtyCt
riskPts = riskUSD / pvQty
tgtPts  = tgtUSD / pvQty
slStructBull = swBullExt - slBuf * atr
slStructBear = swBearExt + slBuf * atr
riskOKBull = not usdMode or not fitStr or (close - slStructBull) <= riskPts
riskOKBear = not usdMode or not fitStr or (slStructBear - close) <= riskPts

// Premium/Discount: rango de las ultimas pdLen velas; equilibrio al 50%
pdHi = ta.highest(high, pdLen)
pdLo = ta.lowest(low, pdLen)
pdEq = (pdHi + pdLo) / 2
pdLongOK  = not usePD or close < pdEq
pdShortOK = not usePD or close > pdEq
dispBullOK = not useDisp or swBullDisp
dispBearOK = not useDisp or swBearDisp

gateBull = sesionOK and mssBullOK and entryBullTrig and riskOKBull and pdLongOK and dispBullOK
gateBear = sesionOK and mssBearOK and entryBearTrig and riskOKBear and pdShortOK and dispBearOK
buySig  = winBull and gateBull and scoreBull >= minScore and barstate.isconfirmed
sellSig = winBear and gateBear and scoreBear >= minScore and barstate.isconfirmed

// BOS de CONTINUACION (experimental): una vela con cuerpo cierra mas alla del
// ultimo swing confirmado A FAVOR del sesgo HTF. Deteccion POR NIVEL: marca
// una vez por swing (aunque el precio ya viniera cayendo/subiendo rapido, que
// es cuando el pivote confirma tarde y el "primer cruce" ya paso).
// Swing PROPIO del BOS (independiente del pivote del barrido)
bosPh  = ta.pivothigh(high, bosPivLen, bosPivLen)
bosPlv = ta.pivotlow(low, bosPivLen, bosPivLen)
var float bosSwHigh = na
var float bosSwLow = na
if not na(bosPh)
    bosSwHigh := bosPh
if not na(bosPlv)
    bosSwLow := bosPlv

var float lastBosBullLvl = na
var float lastBosBearLvl = na
bosBull = useBOS and not na(bosSwHigh) and close > bosSwHigh and (na(lastBosBullLvl) or bosSwHigh != lastBosBullLvl) and math.abs(close - open) >= bosBody * atr and htfBull
bosBear = useBOS and not na(bosSwLow) and close < bosSwLow and (na(lastBosBearLvl) or bosSwLow != lastBosBearLvl) and math.abs(close - open) >= bosBody * atr and htfBear

var int   bosBullBar = na
var float bosBullLvl = na
var bool  bosBullVol = false
var bool  bosBullStrong = false
var bool  bosBullFired = false
var int   bosBearBar = na
var float bosBearLvl = na
var bool  bosBearVol = false
var bool  bosBearStrong = false
var bool  bosBearFired = false

if not na(bosBullBar) and (bar_index - bosBullBar) > bosWin
    bosBullBar := na
if not na(bosBearBar) and (bar_index - bosBearBar) > bosWin
    bosBearBar := na
// Al detectar el BOS guardamos la CALIDAD de la vela (volumen y cuerpo)
// para poder confirmar despues la oportunidad con factores.
if bosBull and barstate.isconfirmed
    bosBullBar := bar_index
    bosBullLvl := bosSwHigh
    lastBosBullLvl := bosSwHigh
    bosBullVol := volOKn
    bosBullStrong := math.abs(close - open) >= atr
    bosBullFired := false
    if bosShow
        label.new(bar_index, low, "BOS?", style=label.style_label_up, color=color.new(color.blue, 40), textcolor=color.white, size=size.tiny)
if bosBear and barstate.isconfirmed
    bosBearBar := bar_index
    bosBearLvl := bosSwLow
    lastBosBearLvl := bosSwLow
    bosBearVol := volOKn
    bosBearStrong := math.abs(close - open) >= atr
    bosBearFired := false
    if bosShow
        label.new(bar_index, high, "BOS?", style=label.style_label_down, color=color.new(color.blue, 40), textcolor=color.white, size=size.tiny)

// Score de confirmacion del BOS (max 6): la oportunidad solo se convierte
// en entrada si los factores la confirman (>= bosScoreMin). HTF ya viene
// alineado por definicion; el resto son VWAP, volumen y cuerpo del BOS.
contScoreBull = 2 + (htfBull ? 1 : 0) + (vwBull ? 1 : 0) + (bosBullVol ? 1 : 0) + (bosBullStrong ? 1 : 0)
contScoreBear = 2 + (htfBear ? 1 : 0) + (vwBear ? 1 : 0) + (bosBearVol ? 1 : 0) + (bosBearStrong ? 1 : 0)

// Riesgo del BOS medido con SU stop (bajo/encima del nivel roto), con SU colchon
riskContBull = not fitStr or (close - (bosBullLvl - bosSlBuf * atr)) <= riskPts
riskContBear = not fitStr or ((bosBearLvl + bosSlBuf * atr) - close) <= riskPts
// Forma de entrada del BOS: retorno al FVG, o retest del propio nivel roto
contBullRetest = bosReqFvg ? (inBullFvg and not na(bullFvgBar) and bullFvgBar >= bosBullBar and close > bosBullLvl) : (low <= bosBullLvl and close > bosBullLvl)
contBearRetest = bosReqFvg ? (inBearFvg and not na(bearFvgBar) and bearFvgBar >= bosBearBar and close < bosBearLvl) : (high >= bosBearLvl and close < bosBearLvl)
contBullOK = not na(bosBullBar) and not bosBullFired and contBullRetest and contScoreBull >= bosScoreMin and riskContBull
contBearOK = not na(bosBearBar) and not bosBearFired and contBearRetest and contScoreBear >= bosScoreMin and riskContBear
buyContSig  = useBOS and contBullOK and sesionOK and barstate.isconfirmed
sellContSig = useBOS and contBearOK and sesionOK and barstate.isconfirmed
slContBull = bosBullLvl - bosSlBuf * atr
slContBear = bosBearLvl + bosSlBuf * atr
entLong  = buySig or buyContSig
entShort = sellSig or sellContSig

// Embudo de diagnostico: cuantos setups sobreviven a cada filtro
var int cntSweep = 0
var int cntMss   = 0
var int cntListo = 0
var int cntSes   = 0
var int cntIn    = 0
if sweepBull or sweepBear
    cntSweep += 1
if mssBullHit or mssBearHit
    cntMss += 1
readyBull = winBull and mssBullOK and entryBullTrig and riskOKBull
readyBear = winBear and mssBearOK and entryBearTrig and riskOKBear
newReady = (readyBull and not readyBull[1]) or (readyBear and not readyBear[1])
if newReady
    cntListo += 1
    if sesionOK
        cntSes += 1
if buySig or sellSig
    cntIn += 1

f_fmt(x) => str.tostring(x, format.mintick)

// ========== 9) EJECUCION DEL BACKTEST + ALERTAS ==========
grpT = "9) Backtest"
useBE    = input.bool(true, "Mover SL a breakeven a mitad de camino", group=grpT)
closeSes = input.bool(true, "Cerrar posiciones al terminar la sesion", group=grpT)

var box  zoneG  = na
var box  zoneR  = na
var line zoneT1 = na

var float posEntry = na
var float posSL  = na
var float posTP1 = na
var float posTP2 = na
var bool  beDone = false

if entLong and strategy.position_size == 0
    isContL = buyContSig and not buySig
    if isContL
        bosBullFired := true
    tp1L = isContL ? bosTp1R : tp1R
    tp2L = isContL ? bosTp2R : tp2R
    posEntry := close
    posSL  := usdMode and not fitStr ? close - riskPts : (buySig ? slStructBull : slContBull)
    posTP1 := usdMode ? close + tgtPts : close + tp1L * (close - posSL)
    posTP2 := usdMode ? close + tgtPts : close + tp2L * (close - posSL)
    beDone := false
    strategy.entry("Long", strategy.long, qty=qtyCt)
    // salidas colocadas en la MISMA vela: el stop protege desde el primer tick
    if usdMode
        strategy.exit("XL", "Long", stop=posSL, limit=posTP1)
    else
        strategy.exit("XL1", "Long", qty_percent=50, stop=posSL, limit=posTP1)
        strategy.exit("XL2", "Long", qty_percent=100, stop=posSL, limit=posTP2)
    if showZone
        zoneG := box.new(bar_index, posTP2, bar_index + 1, posEntry, border_color=color.new(color.green, 55), bgcolor=color.new(color.green, 82))
        zoneR := box.new(bar_index, posEntry, bar_index + 1, posSL, border_color=color.new(color.red, 55), bgcolor=color.new(color.red, 82))
        zoneT1 := line.new(bar_index, posTP1, bar_index + 1, posTP1, color=color.new(color.green, 30), style=line.style_dashed)
        label.new(bar_index, posSL, "LONG", style=label.style_label_up, color=color.new(color.green, 15), textcolor=color.white, size=size.tiny)
    aTxtB = "SMC COMPRA" + (buySig ? "" : " CONT") + " " + syminfo.ticker + " (" + timeframe.period + "m)"
    aTxtB := aTxtB + " | Score " + str.tostring(scoreBull) + "/7"
    aTxtB := aTxtB + " | E " + f_fmt(close) + " SL " + f_fmt(posSL)
    aTxtB := aTxtB + " TP1 " + f_fmt(posTP1) + " TP2 " + f_fmt(posTP2)
    alert(aTxtB, alert.freq_once_per_bar_close)

if entShort and strategy.position_size == 0 and not entLong
    isContS = sellContSig and not sellSig
    if isContS
        bosBearFired := true
    tp1S = isContS ? bosTp1R : tp1R
    tp2S = isContS ? bosTp2R : tp2R
    posEntry := close
    posSL  := usdMode and not fitStr ? close + riskPts : (sellSig ? slStructBear : slContBear)
    posTP1 := usdMode ? close - tgtPts : close - tp1S * (posSL - close)
    posTP2 := usdMode ? close - tgtPts : close - tp2S * (posSL - close)
    beDone := false
    strategy.entry("Short", strategy.short, qty=qtyCt)
    if usdMode
        strategy.exit("XS", "Short", stop=posSL, limit=posTP1)
    else
        strategy.exit("XS1", "Short", qty_percent=50, stop=posSL, limit=posTP1)
        strategy.exit("XS2", "Short", qty_percent=100, stop=posSL, limit=posTP2)
    if showZone
        zoneG := box.new(bar_index, posEntry, bar_index + 1, posTP2, border_color=color.new(color.green, 55), bgcolor=color.new(color.green, 82))
        zoneR := box.new(bar_index, posSL, bar_index + 1, posEntry, border_color=color.new(color.red, 55), bgcolor=color.new(color.red, 82))
        zoneT1 := line.new(bar_index, posTP1, bar_index + 1, posTP1, color=color.new(color.green, 30), style=line.style_dashed)
        label.new(bar_index, posSL, "SHORT", style=label.style_label_down, color=color.new(color.red, 15), textcolor=color.white, size=size.tiny)
    aTxtS = "SMC VENTA" + (sellSig ? "" : " CONT") + " " + syminfo.ticker + " (" + timeframe.period + "m)"
    aTxtS := aTxtS + " | Score " + str.tostring(scoreBear) + "/7"
    aTxtS := aTxtS + " | E " + f_fmt(close) + " SL " + f_fmt(posSL)
    aTxtS := aTxtS + " TP1 " + f_fmt(posTP1) + " TP2 " + f_fmt(posTP2)
    alert(aTxtS, alert.freq_once_per_bar_close)

// Breakeven: en modo USD se activa a mitad de camino al TP;
// en modo ATR se activa cuando el precio toca TP1
beTrigL = usdMode ? posEntry + (posTP1 - posEntry) / 2 : posTP1
beTrigS = usdMode ? posEntry - (posEntry - posTP1) / 2 : posTP1

if strategy.position_size > 0
    if useBE and not beDone and high >= beTrigL
        beDone := true
    stopL = beDone ? posEntry : posSL
    if usdMode
        strategy.exit("XL", "Long", stop=stopL, limit=posTP1)
    else
        strategy.exit("XL1", "Long", qty_percent=50, stop=stopL, limit=posTP1)
        strategy.exit("XL2", "Long", qty_percent=100, stop=stopL, limit=posTP2)

if strategy.position_size < 0
    if useBE and not beDone and low <= beTrigS
        beDone := true
    stopS = beDone ? posEntry : posSL
    if usdMode
        strategy.exit("XS", "Short", stop=stopS, limit=posTP1)
    else
        strategy.exit("XS1", "Short", qty_percent=50, stop=stopS, limit=posTP1)
        strategy.exit("XS2", "Short", qty_percent=100, stop=stopS, limit=posTP2)

if closeSes and strategy.position_size != 0 and not inNY and not (useLDN and inLDN)
    strategy.close_all(comment="Fin de sesion")

// Las zonas pintadas viven mientras la operacion esta abierta y se
// congelan donde cerro (el borde derecho ES la salida de la operacion)
if strategy.position_size != 0
    if not na(zoneG)
        box.set_right(zoneG, bar_index)
    if not na(zoneR)
        box.set_right(zoneR, bar_index)
    if not na(zoneT1)
        line.set_x2(zoneT1, bar_index)

// ========== 10) PANEL DE ESTADO ==========
grpD = "10) Panel"
showTbl = input.bool(true, "Mostrar panel de estado", group=grpD)
var table tbl = table.new(position.top_right, 2, 10,
     bgcolor=color.new(color.black, 20), border_width=1,
     border_color=color.new(color.gray, 60))
if showTbl and barstate.islast
    cUp = color.new(color.green, 0)
    cDn = color.new(color.red, 0)
    cNe = color.new(color.silver, 0)
    cWa = color.new(color.orange, 0)
    setupTxt = "Esperando barrido"
    setupCol = cNe
    if winBull
        mTx = swBullMss ? "MSS OK" : "MSS..."
        fTx = reqFVG ? (inBullFvg ? " | FVG OK" : " | FVG...") : ""
        setupTxt := "LONG " + str.tostring(scoreBull) + "/7 | " + mTx + fTx
        setupCol := cUp
    if winBear
        mTx = swBearMss ? "MSS OK" : "MSS..."
        fTx = reqFVG ? (inBearFvg ? " | FVG OK" : " | FVG...") : ""
        setupTxt := "SHORT " + str.tostring(scoreBear) + "/7 | " + mTx + fTx
        setupCol := cDn
    bullNewer = na(lastBearSweepBar) or (not na(lastBullSweepBar) and lastBullSweepBar > lastBearSweepBar)
    lastSwTxt = "-"
    if not na(lastBullSweepBar) and bullNewer
        lastSwTxt := "Low barrido hace " + str.tostring(bar_index - lastBullSweepBar)
    else if not na(lastBearSweepBar)
        lastSwTxt := "High barrido hace " + str.tostring(bar_index - lastBearSweepBar)
    htfTxt = not htfValido ? "TF >= HTF !" : htfBull ? "Alcista" : "Bajista"
    htfCol = not htfValido ? cWa : htfBull ? cUp : cDn
    smtTxt = not useSMT ? "Off" : corrOK ? "Datos OK" : "SIN DATOS !"
    smtCol = not useSMT ? cNe : corrOK ? cUp : cWa
    modoTxt = (reqMSS ? "MSS" : "-") + " + " + (reqFVG ? "FVG" : "directo")
    modoTxt := modoTxt + " | min " + str.tostring(minScore)
    modoTxt := modoTxt + (useBOS ? " +BOS" : "")
    if usdMode
        modoTxt := modoTxt + " | USD -" + str.tostring(riskUSD, "#") + "/+" + str.tostring(tgtUSD, "#")
    table.cell(tbl, 0, 0, "SMC MASTER v2", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 0, syminfo.ticker + " " + timeframe.period, text_color=color.white, text_size=size.small)
    sesTxt = inNews ? "NOTICIAS" : sesionOK ? "ACTIVA" : "FUERA"
    sesCol = inNews ? cWa : sesionOK ? cUp : cDn
    table.cell(tbl, 0, 1, "Sesion", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 1, sesTxt, text_color=sesCol, text_size=size.tiny)
    table.cell(tbl, 0, 2, "Sesgo TF mayor", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 2, htfTxt, text_color=htfCol, text_size=size.tiny)
    table.cell(tbl, 0, 3, "VWAP", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 3, vwBull ? "Encima" : "Debajo", text_color=vwBull ? cUp : cDn, text_size=size.tiny)
    table.cell(tbl, 0, 4, "Volumen", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 4, volOKn ? "Alto" : "Normal", text_color=volOKn ? cUp : cNe, text_size=size.tiny)
    table.cell(tbl, 0, 5, "SMT", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 5, smtTxt, text_color=smtCol, text_size=size.tiny)
    table.cell(tbl, 0, 6, "Ult. barrido", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 6, lastSwTxt, text_color=cNe, text_size=size.tiny)
    table.cell(tbl, 0, 7, "Setup", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 7, setupTxt, text_color=setupCol, text_size=size.tiny)
    table.cell(tbl, 0, 8, "Modo", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 8, modoTxt, text_color=cNe, text_size=size.tiny)
    funTxt = str.tostring(cntSweep) + " > " + str.tostring(cntMss) + " > " + str.tostring(cntListo)
    funTxt := funTxt + " > " + str.tostring(cntSes) + " > " + str.tostring(cntIn)
    table.cell(tbl, 0, 9, "Embudo B>M>L>S>E", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 9, funTxt, text_color=cWa, text_size=size.tiny)
