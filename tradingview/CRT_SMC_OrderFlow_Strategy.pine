//@version=6
// ===========================================================================
//  CRT + SMC + ORDER FLOW  -  STRATEGY (backtest)   ES / NQ, 1 minuto
//
//  Version de backtest del indicador CRT+SMC+Order Flow. Ejecuta el setup
//  (Sweep -> MSS + Volumen -> FVG -> limite) y SOLO entra cuando el order
//  flow del sweep confirma la direccion (delta comprador en largos, delta
//  vendedor en cortos). Ese filtro fue el que mejor separo ganadores de
//  perdedores en los datos reales de ticks de ES (PF 1.0 -> ~1.9).
//
//  El delta se aproxima con request.security_lower_tf (sub-vela alcista =
//  compra, bajista = venta). Es la misma tecnica del "Volume Delta" de TV.
//
//  ====================  LIMITACION IMPORTANTE  ==========================
//  request.security_lower_tf solo entrega intrabars de las ~2 semanas mas
//  recientes que TradingView carga en 1m. En las velas mas viejas el delta
//  llega como 0 y el filtro de order flow NO actua (deja pasar todo). Por
//  eso el backtest CON filtro OF solo es fiable en el tramo reciente.
//  Para validar el filtro en 6 meses usa el script de Python sobre tus ticks.
//  =======================================================================
//
//  TEMPORALIDAD: 1 MINUTO. En los datos reales de ticks la reversion rindio
//  claramente mejor en 1m (PF ~1.93) que en 5m (PF ~1.68). Montala en 1m ES.
//  (El BOS de continuacion se probo y NO funciono en 1m ni 5m: se descarta.)
//
//  GESTION DIARIA: stop de perdida diaria + tope de trades/dia bajan el
//  drawdown a la mitad y suben la ganancia (ver grupo "Gestion diaria").
//
//  ANTI-REPINTADO: barstate.isconfirmed, niveles por acumulador nativo,
//  lookahead_off. 100% ASCII.
// ===========================================================================
strategy("CRT + SMC + OF Strategy", "CRT-SMC-OF",
     overlay              = true,
     initial_capital      = 25000,
     default_qty_type     = strategy.fixed,
     default_qty_value    = 2,
     commission_type      = strategy.commission.cash_per_contract,
     commission_value     = 2.50,
     slippage             = 1,
     margin_long          = 0,
     margin_short         = 0,
     pyramiding           = 0,
     calc_on_every_tick   = false,
     process_orders_on_close = true,
     max_boxes_count      = 200,
     max_lines_count      = 200,
     max_labels_count     = 300)

confirmada = barstate.isconfirmed

// ------------------------------- INPUTS ------------------------------------
g1 = "Sesgo CRT y sesiones"
tzNY      = input.string("America/New_York", "Zona horaria", group=g1)
horaAsiaI = input.int(18, "Inicio sesion asiatica (EST)", minval=0, maxval=23, group=g1)
usarCRT   = input.bool(true, "Aplicar sesgo CRT", group=g1)
usarKZ    = input.bool(true, "Operar solo en killzones", group=g1)
usarAM    = input.bool(true, "Killzone NY AM", group=g1)
usarPM    = input.bool(false, "Killzone NY PM", group=g1)
sesionAM  = input.session("0930-1100", "Horario AM (EST)", group=g1)
sesionPM  = input.session("1330-1500", "Horario PM (EST)", group=g1)

g2 = "Setup"
pivLen    = input.int(5,    "Longitud de pivote (MSS)", minval=2, group=g2)
mechaMin  = input.float(0.20, "Mecha minima del sweep (x ATR)", minval=0, step=0.05, group=g2)
volLen    = input.int(20,   "Periodo SMA de volumen", minval=1, group=g2)
volMult   = input.float(2.0, "Volumen minimo del MSS (x SMA)", minval=1.0, step=0.1, group=g2)
fvgMin    = input.float(0.15, "Tamano minimo del FVG (x ATR)", minval=0, step=0.05, group=g2)
barrasFVG = input.int(10,   "Velas max. para el FVG", minval=1, group=g2)
barrasLim = input.int(60,   "Velas max. que vive el limite", minval=1, group=g2)
usarAsia  = input.bool(true, "Sweep de Asian High/Low", group=g2)
usarPD    = input.bool(true, "Sweep de PDH/PDL", group=g2)

g3 = "ORDER FLOW (filtro)"
usarOF    = input.bool(true, "Entrar SOLO si el order flow confirma", group=g3)
tfDelta   = input.timeframe("5S", "Timeframe del delta (menor al grafico)", group=g3)
umbralOF  = input.float(0.0, "Umbral minimo de delta a favor", minval=0, group=g3)

g4 = "Gestion de riesgo"
contratos = input.int(2,    "Contratos (par para TP escalonado)", minval=2, group=g4)
tp1R      = input.float(2.0, "TP1 (R) - cierra 50%", minval=0.1, step=0.1, group=g4)
tp2R      = input.float(3.0, "TP2 (R) - cierra el resto", minval=0.1, step=0.1, group=g4)
usarBE    = input.bool(false, "Breakeven tras TP1", group=g4)
horaCierre= input.int(16,   "Hora de cierre forzado (EST)", minval=0, maxval=23, group=g4)
rMax      = input.float(20.0, "R maxima (puntos)", minval=1, group=g4)
rMin      = input.float(5.0,  "R minima (puntos, 0 = sin filtro)", minval=0, group=g4)

g5 = "Visual"
verZonas  = input.bool(true, "Pintar zona riesgo/premio", group=g5)
verKZ     = input.bool(true, "Sombrear killzones", group=g5)

// ------------------------- ORDER FLOW (delta) ------------------------------
[oArr, cArr, vArr] = request.security_lower_tf(syminfo.tickerid, tfDelta, [open, close, volume])
f_delta() =>
    float d = 0.0
    int n = array.size(cArr)
    if n > 0
        for i = 0 to n - 1
            float v = array.get(vArr, i)
            d += array.get(cArr, i) >= array.get(oArr, i) ? v : -v
    d
deltaBar = f_delta()

// ------------------------- NIVELES MACRO Y CRT -----------------------------
atr = ta.atr(14)
nyHora = hour(time, tzNY)
nyDia  = dayofmonth(time, tzNY)
nuevoDiaNY = nyDia != nyDia[1]

var float acDiaH  = na
var float acDiaL  = na
var float acAsiaH = na
var float acAsiaL = na
var float midOpen = na
var float asiaH   = na
var float asiaL   = na
var float pdh     = na
var float pdl     = na

enAsia     = nyHora >= horaAsiaI
inicioAsia = enAsia and not enAsia[1]

if nuevoDiaNY
    midOpen := open
    asiaH   := acAsiaH
    asiaL   := acAsiaL
    pdh     := acDiaH
    pdl     := acDiaL
    acDiaH  := high
    acDiaL  := low
else
    acDiaH := na(acDiaH) ? high : math.max(acDiaH, high)
    acDiaL := na(acDiaL) ? low  : math.min(acDiaL, low)

if inicioAsia
    acAsiaH := high
    acAsiaL := low
else if enAsia
    acAsiaH := na(acAsiaH) ? high : math.max(acAsiaH, high)
    acAsiaL := na(acAsiaL) ? low  : math.min(acAsiaL, low)

crtAlcista = not usarCRT or (not na(midOpen) and close < midOpen)
crtBajista = not usarCRT or (not na(midOpen) and close > midOpen)

// ------------------------------ KILLZONES ----------------------------------
enAM = usarAM and not na(time(timeframe.period, sesionAM, tzNY))
enPM = usarPM and not na(time(timeframe.period, sesionPM, tzNY))
enKZ = enAM or enPM
kzOK = not usarKZ or enKZ
bgcolor(verKZ and enAM ? color.new(color.teal, 93) : na, title="KZ AM")
bgcolor(verKZ and enPM ? color.new(color.blue, 93) : na, title="KZ PM")

// -------------------------------- SETUP ------------------------------------
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low,  pivLen, pivLen)
var float ultPH = na
var float ultPL = na
if not na(ph)
    ultPH := ph
if not na(pl)
    ultPL := pl

volSMA = ta.sma(volume, volLen)
volOK  = volume > volSMA * volMult

nivelCompraA = usarPD   ? pdl   : na
nivelCompraB = usarAsia ? asiaL : na
nivelVentaA  = usarPD   ? pdh   : na
nivelVentaB  = usarAsia ? asiaH : na

mechaInf = math.min(open, close) - low
mechaSup = high - math.max(open, close)

barridoL(nivel) => not na(nivel) and low  < nivel and close > nivel and mechaInf >= mechaMin * atr
barridoS(nivel) => not na(nivel) and high > nivel and close < nivel and mechaSup >= mechaMin * atr

sweepL = confirmada and crtAlcista and (barridoL(nivelCompraA) or barridoL(nivelCompraB))
sweepS = confirmada and crtBajista and (barridoS(nivelVentaA)  or barridoS(nivelVentaB))

var int   faseL = 0
var float extL  = na
var int   barMssL = na
var float limL  = na
var float slL   = na
var float ofL   = na
var int   venceL = na

var int   faseS = 0
var float extS  = na
var int   barMssS = na
var float limS  = na
var float slS   = na
var float ofS   = na
var int   venceS = na

var box   zRiskL = na
var box   zPremL = na
var box   zRiskS = na
var box   zPremS = na
borrarL() =>
    box.delete(zRiskL)
    box.delete(zPremL)
borrarS() =>
    box.delete(zRiskS)
    box.delete(zPremS)

// ---- LADO COMPRADOR ----
if sweepL
    faseL := 1
    extL  := low
    ofL   := deltaBar
if faseL == 1 and confirmada and not na(ultPH) and close > ultPH and volOK
    faseL   := 2
    barMssL := bar_index
if faseL == 2 and confirmada and not na(barMssL)
    if bar_index - barMssL > barrasFVG
        faseL := 0
    else if low > high[2] and (low - high[2]) >= fvgMin * atr
        limL := low
        slL  := extL - syminfo.mintick
        rr   = limL - slL
        okOF = not usarOF or ofL >= umbralOF
        pasa = not na(rr) and rr > 0 and rr <= rMax and (rMin <= 0 or rr >= rMin) and okOF
        if pasa
            venceL := bar_index + barrasLim
            faseL  := 3
            if verZonas
                borrarL()
                zRiskL := box.new(bar_index, limL, bar_index + barrasLim, slL, border_color=color.new(color.red, 60), bgcolor=color.new(color.red, 90))
                zPremL := box.new(bar_index, limL + tp2R * rr, bar_index + barrasLim, limL, border_color=color.new(color.green, 60), bgcolor=color.new(color.green, 90))
        else
            faseL := 0
if faseL == 3 and (bar_index > venceL or low <= slL)
    faseL := 0
    borrarL()

// ---- LADO VENDEDOR ----
if sweepS
    faseS := 1
    extS  := high
    ofS   := deltaBar
if faseS == 1 and confirmada and not na(ultPL) and close < ultPL and volOK
    faseS   := 2
    barMssS := bar_index
if faseS == 2 and confirmada and not na(barMssS)
    if bar_index - barMssS > barrasFVG
        faseS := 0
    else if high < low[2] and (low[2] - high) >= fvgMin * atr
        limS := high
        slS  := extS + syminfo.mintick
        rr   = slS - limS
        okOF = not usarOF or ofS <= -umbralOF
        pasa = not na(rr) and rr > 0 and rr <= rMax and (rMin <= 0 or rr >= rMin) and okOF
        if pasa
            venceS := bar_index + barrasLim
            faseS  := 3
            if verZonas
                borrarS()
                zRiskS := box.new(bar_index, slS, bar_index + barrasLim, limS, border_color=color.new(color.red, 60), bgcolor=color.new(color.red, 90))
                zPremS := box.new(bar_index, limS, bar_index + barrasLim, limS - tp2R * rr, border_color=color.new(color.green, 60), bgcolor=color.new(color.green, 90))
        else
            faseS := 0
if faseS == 3 and (bar_index > venceS or high >= slS)
    faseS := 0
    borrarS()

// ------------------------- GESTION DIARIA (baja el drawdown) ---------------
// En los datos, un stop diario ~-800 USD y un tope de 3 trades/dia bajaron el
// drawdown a la mitad Y subieron la ganancia (cortan el sangrado de dias trend).
gDia    = "Gestion diaria (baja el DD)"
stopDia = input.float(800, "Stop de perdida diaria (USD, 0 = off)", minval=0, group=gDia)
maxTrDia= input.int(3, "Maximo de trades por dia (0 = sin limite)", minval=0, group=gDia)

var float netIniDia = 0.0
var int   trHoy = 0
if nuevoDiaNY
    netIniDia := strategy.netprofit
    trHoy := 0
pnlHoy = strategy.netprofit - netIniDia
diaOK = (maxTrDia <= 0 or trHoy < maxTrDia) and (stopDia <= 0 or pnlHoy > -stopDia)

// ------------------------- GESTION Y EJECUCION -----------------------------
cierreSesion = nyHora >= horaCierre and nyHora[1] < horaCierre
rLargo = na(limL) or na(slL) ? na : limL - slL
rCorto = na(limS) or na(slS) ? na : slS - limS
puedeOperar = kzOK and not cierreSesion and diaOK

var bool beL = false
var bool beS = false

if faseL == 3 and puedeOperar and strategy.position_size == 0 and not na(rLargo) and rLargo > 0
    strategy.entry("L", strategy.long, qty=contratos, limit=limL, comment="OF-Long")
if faseS == 3 and puedeOperar and strategy.position_size == 0 and not na(rCorto) and rCorto > 0
    strategy.entry("S", strategy.short, qty=contratos, limit=limS, comment="OF-Short")

if strategy.position_size > 0
    if usarBE and not beL and high >= limL + tp1R * rLargo
        beL := true
    stopL = usarBE and beL ? strategy.position_avg_price : slL
    strategy.exit("L-TP1", from_entry="L", qty_percent=50, limit=limL + tp1R * rLargo, stop=slL, comment_profit="TP1", comment_loss="SL")
    strategy.exit("L-TP2", from_entry="L", limit=limL + tp2R * rLargo, stop=stopL, comment_profit="TP2", comment_loss="BE/SL")

if strategy.position_size < 0
    if usarBE and not beS and low <= limS - tp1R * rCorto
        beS := true
    stopS = usarBE and beS ? strategy.position_avg_price : slS
    strategy.exit("S-TP1", from_entry="S", qty_percent=50, limit=limS - tp1R * rCorto, stop=slS, comment_profit="TP1", comment_loss="SL")
    strategy.exit("S-TP2", from_entry="S", limit=limS - tp2R * rCorto, stop=stopS, comment_profit="TP2", comment_loss="BE/SL")

if strategy.position_size != 0 and strategy.position_size[1] == 0
    faseL := 0
    faseS := 0
    trHoy += 1
    borrarL()
    borrarS()
if strategy.position_size == 0 and strategy.position_size[1] != 0
    beL := false
    beS := false

if cierreSesion
    strategy.cancel_all()
    if strategy.position_size != 0
        strategy.close_all(comment="Cierre 16:00")
    faseL := 0
    faseS := 0
    borrarL()
    borrarS()

// -------------------------------- PANEL ------------------------------------
var table pnl = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 25), border_width=1, border_color=color.new(color.gray, 70))
if barstate.islast
    fase  = faseL == 3 or faseS == 3 ? "Setup armado" : faseL >= 1 or faseS >= 1 ? "En proceso" : "Sin setup"
    dcol  = deltaBar > 0 ? color.lime : deltaBar < 0 ? color.red : color.gray
    table.cell(pnl, 0, 0, "Filtro OF", text_color=color.white, text_size=size.tiny)
    table.cell(pnl, 1, 0, usarOF ? "ON" : "OFF", text_color=usarOF ? color.lime : color.gray, text_size=size.tiny)
    table.cell(pnl, 0, 1, "Delta vela", text_color=color.white, text_size=size.tiny)
    table.cell(pnl, 1, 1, str.tostring(math.round(deltaBar)), text_color=dcol, text_size=size.tiny)
    table.cell(pnl, 0, 2, "Fase", text_color=color.white, text_size=size.tiny)
    table.cell(pnl, 1, 2, fase, text_color=color.orange, text_size=size.tiny)
    table.cell(pnl, 0, 3, "Killzone", text_color=color.white, text_size=size.tiny)
    table.cell(pnl, 1, 3, enAM ? "NY AM" : enPM ? "NY PM" : "Fuera", text_color=enKZ ? color.lime : color.gray, text_size=size.tiny)
