//@version=6
// ===========================================================================
//  CRT + SMC + ORDER FLOW  -  Indicador de senales (ES / NQ, 1 minuto)
//
//  Detecta el setup del sistema (Sweep -> MSS + Volumen -> FVG) y le anade la
//  pieza que resulto ser el mejor filtro en los datos reales de ticks:
//  el ORDER FLOW (delta comprador/vendedor) en la vela del barrido.
//
//  En el backtest de ticks de ES, filtrar por "el order flow confirma la
//  direccion" separo ganadores de perdedores de forma consistente:
//     - OF confirma  -> ~52% aciertos, PF ~1.6
//     - OF en contra -> ~24% aciertos, PF ~0.5
//  Regla: LARGO valido si hay delta COMPRADOR en el sweep; CORTO valido si
//  hay delta VENDEDOR. Si el flujo va en contra, es ruptura real, no un grab.
//
//  El delta se aproxima con request.security_lower_tf: cada sub-vela del
//  timeframe menor cuenta como compra (cierra >= abre) o venta (cierra < abre).
//  Es la misma tecnica del indicador "Volume Delta" de TradingView.
//
//  ANTI-REPINTADO: las senales se evaluan en barstate.isconfirmed. Niveles
//  macro por acumulador nativo. lookahead_off en todo request.
//  100% ASCII para pegar sin errores.
// ===========================================================================
indicator("CRT + SMC + Order Flow", "CRT-SMC OF", overlay=true,
     max_boxes_count=200, max_labels_count=300, max_lines_count=200)

confirmada = barstate.isconfirmed

// ------------------------------- INPUTS ------------------------------------
g1 = "Sesgo CRT y sesiones"
tzNY      = input.string("America/New_York", "Zona horaria", group=g1)
horaAsiaI = input.int(18, "Inicio sesion asiatica (EST)", minval=0, maxval=23, group=g1)
usarCRT   = input.bool(true, "Aplicar sesgo CRT (Premium/Discount)", group=g1)
usarKZ    = input.bool(true, "Operar solo en killzones", group=g1)
usarAM    = input.bool(true, "Killzone NY AM (0930-1100)", group=g1)
usarPM    = input.bool(false, "Killzone NY PM (1330-1500)", group=g1)
sesionAM  = input.session("0930-1100", "Horario AM (EST)", group=g1)
sesionPM  = input.session("1330-1500", "Horario PM (EST)", group=g1)

g2 = "Setup (Sweep -> MSS -> FVG)"
pivLen    = input.int(5,    "Longitud de pivote (MSS)", minval=2, group=g2)
mechaMin  = input.float(0.20, "Mecha minima del sweep (x ATR)", minval=0, step=0.05, group=g2)
volLen    = input.int(20,   "Periodo SMA de volumen", minval=1, group=g2)
volMult   = input.float(2.0, "Volumen minimo del MSS (x SMA)", minval=1.0, step=0.1, group=g2)
fvgMin    = input.float(0.15, "Tamano minimo del FVG (x ATR)", minval=0, step=0.05, group=g2)
barrasFVG = input.int(10,   "Velas max. para el FVG tras el MSS", minval=1, group=g2)
usarAsia  = input.bool(true, "Sweep de Asian High/Low", group=g2)
usarPD    = input.bool(true, "Sweep de PDH/PDL", group=g2)
rMax      = input.float(20.0, "R maxima (puntos)", minval=1, group=g2)
rMin      = input.float(5.0,  "R minima (puntos, 0 = sin filtro)", minval=0, group=g2)
tp1R      = input.float(2.0, "TP1 (R)", minval=0.1, step=0.1, group=g2)
tp2R      = input.float(3.0, "TP2 (R)", minval=0.1, step=0.1, group=g2)

g3 = "ORDER FLOW (delta)"
tfDelta   = input.timeframe("5S", "Timeframe del delta (menor al del grafico)", group=g3)
soloOF    = input.bool(false, "Mostrar SOLO setups con order flow a favor", group=g3, tooltip="Si lo activas, oculta los setups donde el flujo va en contra.")
umbralOF  = input.float(0.0, "Umbral minimo de delta a favor (contratos)", minval=0, group=g3)

g4 = "Visual"
verZonas  = input.bool(true, "Pintar zona riesgo/premio", group=g4)
verNiveles= input.bool(true, "Dibujar niveles macro", group=g4)
verKZ     = input.bool(true, "Sombrear killzones", group=g4)
verPanel  = input.bool(true, "Panel de estado", group=g4)

// ------------------------- ORDER FLOW (delta) ------------------------------
// Cada sub-vela del TF menor: compra si cierra >= abre, venta si cierra < abre.
[oArr, cArr, vArr] = request.security_lower_tf(syminfo.tickerid, tfDelta, [open, close, volume])
f_delta() =>
    float d = 0.0
    int n = array.size(cArr)
    if n > 0
        for i = 0 to n - 1
            float v = array.get(vArr, i)
            d += array.get(cArr, i) >= array.get(oArr, i) ? v : -v
    d
deltaBar = f_delta()

// ------------------------- NIVELES MACRO Y CRT -----------------------------
atr = ta.atr(14)
nyHora = hour(time, tzNY)
nyDia  = dayofmonth(time, tzNY)
nuevoDiaNY = nyDia != nyDia[1]

var float acDiaH  = na
var float acDiaL  = na
var float acAsiaH = na
var float acAsiaL = na
var float midOpen = na
var float asiaH   = na
var float asiaL   = na
var float pdh     = na
var float pdl     = na

enAsia     = nyHora >= horaAsiaI
inicioAsia = enAsia and not enAsia[1]

if nuevoDiaNY
    midOpen := open
    asiaH   := acAsiaH
    asiaL   := acAsiaL
    pdh     := acDiaH
    pdl     := acDiaL
    acDiaH  := high
    acDiaL  := low
else
    acDiaH := na(acDiaH) ? high : math.max(acDiaH, high)
    acDiaL := na(acDiaL) ? low  : math.min(acDiaL, low)

if inicioAsia
    acAsiaH := high
    acAsiaL := low
else if enAsia
    acAsiaH := na(acAsiaH) ? high : math.max(acAsiaH, high)
    acAsiaL := na(acAsiaL) ? low  : math.min(acAsiaL, low)

crtAlcista = not usarCRT or (not na(midOpen) and close < midOpen)
crtBajista = not usarCRT or (not na(midOpen) and close > midOpen)

// ------------------------------ KILLZONES ----------------------------------
enAM = usarAM and not na(time(timeframe.period, sesionAM, tzNY))
enPM = usarPM and not na(time(timeframe.period, sesionPM, tzNY))
enKZ = enAM or enPM
kzOK = not usarKZ or enKZ
bgcolor(verKZ and enAM ? color.new(color.teal, 93) : na, title="KZ AM")
bgcolor(verKZ and enPM ? color.new(color.blue, 93) : na, title="KZ PM")

// -------------------------------- SETUP ------------------------------------
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low,  pivLen, pivLen)
var float ultPH = na
var float ultPL = na
if not na(ph)
    ultPH := ph
if not na(pl)
    ultPL := pl

volSMA = ta.sma(volume, volLen)
volOK  = volume > volSMA * volMult

nivelCompraA = usarPD   ? pdl   : na
nivelCompraB = usarAsia ? asiaL : na
nivelVentaA  = usarPD   ? pdh   : na
nivelVentaB  = usarAsia ? asiaH : na

mechaInf = math.min(open, close) - low
mechaSup = high - math.max(open, close)

barridoL(nivel) => not na(nivel) and low  < nivel and close > nivel and mechaInf >= mechaMin * atr
barridoS(nivel) => not na(nivel) and high > nivel and close < nivel and mechaSup >= mechaMin * atr

sweepL = confirmada and crtAlcista and (barridoL(nivelCompraA) or barridoL(nivelCompraB))
sweepS = confirmada and crtBajista and (barridoS(nivelVentaA)  or barridoS(nivelVentaB))

var int   faseL = 0
var float extL  = na
var int   barMssL = na
var float limL  = na
var float slL   = na
var float ofL   = na
var int   faseS = 0
var float extS  = na
var int   barMssS = na
var float limS  = na
var float slS   = na
var float ofS   = na

var box   cajaL = na
var box   cajaS = na
var box   zRiskL = na
var box   zPremL = na
var box   zRiskS = na
var box   zPremS = na
borrarL() =>
    box.delete(cajaL)
    box.delete(zRiskL)
    box.delete(zPremL)
borrarS() =>
    box.delete(cajaS)
    box.delete(zRiskS)
    box.delete(zPremS)

f_fmt(x) => str.tostring(x, format.mintick)
f_delt(x) => str.tostring(math.round(x))

// ---- LADO COMPRADOR ----
if sweepL
    faseL := 1
    extL  := low
    ofL   := deltaBar
if faseL == 1 and confirmada and not na(ultPH) and close > ultPH and volOK
    faseL   := 2
    barMssL := bar_index
if faseL == 2 and confirmada and not na(barMssL)
    if bar_index - barMssL > barrasFVG
        faseL := 0
    else if low > high[2] and (low - high[2]) >= fvgMin * atr
        limL := low
        slL  := extL - syminfo.mintick
        rr   = limL - slL
        okOF = ofL >= umbralOF
        pasa = (not na(rr) and rr > 0 and rr <= rMax and (rMin <= 0 or rr >= rMin)) and (not soloOF or okOF)
        if pasa
            faseL := 3
            tp1 = limL + tp1R * rr
            tp2 = limL + tp2R * rr
            if verZonas
                borrarL()
                zRiskL := box.new(bar_index, limL, bar_index + 30, slL, border_color=color.new(color.red, 60),   bgcolor=color.new(color.red, 90))
                zPremL := box.new(bar_index, tp2, bar_index + 30, limL, border_color=color.new(color.green, 60), bgcolor=color.new(color.green, 90))
            etq = okOF ? "COMPRA OF OK" : "COMPRA OF CONTRA"
            tip = "COMPRA R=" + str.tostring(rr, format.mintick) + " | delta sweep " + f_delt(ofL) + " | E " + f_fmt(limL) + " SL " + f_fmt(slL) + " TP1 " + f_fmt(tp1) + " TP2 " + f_fmt(tp2)
            label.new(bar_index, slL, etq, yloc=yloc.belowbar, style=label.style_label_up, color=okOF ? color.new(color.green, 10) : color.new(color.gray, 30), textcolor=color.white, size=size.small, tooltip=tip)
        else
            faseL := 0
if faseL == 3 and (low <= slL or bar_index > barMssL + 120)
    faseL := 0

// ---- LADO VENDEDOR ----
if sweepS
    faseS := 1
    extS  := high
    ofS   := deltaBar
if faseS == 1 and confirmada and not na(ultPL) and close < ultPL and volOK
    faseS   := 2
    barMssS := bar_index
if faseS == 2 and confirmada and not na(barMssS)
    if bar_index - barMssS > barrasFVG
        faseS := 0
    else if high < low[2] and (low[2] - high) >= fvgMin * atr
        limS := high
        slS  := extS + syminfo.mintick
        rr   = slS - limS
        okOF = ofS <= -umbralOF
        pasa = (not na(rr) and rr > 0 and rr <= rMax and (rMin <= 0 or rr >= rMin)) and (not soloOF or okOF)
        if pasa
            faseS := 3
            tp1 = limS - tp1R * rr
            tp2 = limS - tp2R * rr
            if verZonas
                borrarS()
                zRiskS := box.new(bar_index, slS, bar_index + 30, limS, border_color=color.new(color.red, 60),   bgcolor=color.new(color.red, 90))
                zPremS := box.new(bar_index, limS, bar_index + 30, tp2, border_color=color.new(color.green, 60), bgcolor=color.new(color.green, 90))
            etq = okOF ? "VENTA OF OK" : "VENTA OF CONTRA"
            tip = "VENTA R=" + str.tostring(rr, format.mintick) + " | delta sweep " + f_delt(ofS) + " | E " + f_fmt(limS) + " SL " + f_fmt(slS) + " TP1 " + f_fmt(tp1) + " TP2 " + f_fmt(tp2)
            label.new(bar_index, slS, etq, yloc=yloc.abovebar, style=label.style_label_down, color=okOF ? color.new(color.red, 10) : color.new(color.gray, 30), textcolor=color.white, size=size.small, tooltip=tip)
        else
            faseS := 0
if faseS == 3 and (high >= slS or bar_index > barMssS + 120)
    faseS := 0

// ------------------------------- NIVELES -----------------------------------
var line lnMid = na
var line lnAH  = na
var line lnAL  = na
var line lnPDH = na
var line lnPDL = na
pintar(ln, precio, col, est) =>
    line res = ln
    if verNiveles and not na(precio)
        if na(res)
            res := line.new(bar_index - 1, precio, bar_index, precio, color=col, style=est, width=1, extend=extend.right)
        else
            line.set_xy1(res, bar_index - 1, precio)
            line.set_xy2(res, bar_index, precio)
    res
if barstate.islast
    lnMid := pintar(lnMid, midOpen, color.new(color.orange, 20), line.style_solid)
    lnAH  := pintar(lnAH,  asiaH,   color.new(color.gray, 30),   line.style_dotted)
    lnAL  := pintar(lnAL,  asiaL,   color.new(color.gray, 30),   line.style_dotted)
    lnPDH := pintar(lnPDH, pdh,     color.new(color.red, 40),    line.style_dashed)
    lnPDL := pintar(lnPDL, pdl,     color.new(color.green, 40),  line.style_dashed)

// -------------------------------- PANEL ------------------------------------
var table pnl = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 25), border_width=1, border_color=color.new(color.gray, 70))
if verPanel and barstate.islast
    sesgo = not usarCRT ? "Off" : crtAlcista ? "Discount -> Largos" : "Premium -> Cortos"
    fase  = faseL == 3 or faseS == 3 ? "Setup armado" : faseL == 2 or faseS == 2 ? "Esperando FVG" : faseL == 1 or faseS == 1 ? "Esperando MSS" : "Sin setup"
    dcol  = deltaBar > 0 ? color.lime : deltaBar < 0 ? color.red : color.gray
    table.cell(pnl, 0, 0, "Sesgo CRT", text_color=color.white, text_size=size.tiny)
    table.cell(pnl, 1, 0, sesgo, text_color=crtAlcista ? color.lime : color.red, text_size=size.tiny)
    table.cell(pnl, 0, 1, "Killzone", text_color=color.white, text_size=size.tiny)
    table.cell(pnl, 1, 1, enAM ? "NY AM" : enPM ? "NY PM" : "Fuera", text_color=enKZ ? color.lime : color.gray, text_size=size.tiny)
    table.cell(pnl, 0, 2, "Fase", text_color=color.white, text_size=size.tiny)
    table.cell(pnl, 1, 2, fase, text_color=color.orange, text_size=size.tiny)
    table.cell(pnl, 0, 3, "Delta vela (OF)", text_color=color.white, text_size=size.tiny)
    table.cell(pnl, 1, 3, f_delt(deltaBar), text_color=dcol, text_size=size.tiny)
    table.cell(pnl, 0, 4, "Volumen", text_color=color.white, text_size=size.tiny)
    table.cell(pnl, 1, 4, volOK ? "Institucional" : "Normal", text_color=volOK ? color.lime : color.gray, text_size=size.tiny)

// -------------------------------- ALERTAS ----------------------------------
armadoL_OF = faseL == 3 and faseL[1] != 3 and ofL >= umbralOF
armadoS_OF = faseS == 3 and faseS[1] != 3 and ofS <= -umbralOF
alertcondition(armadoL_OF, title="COMPRA con order flow a favor", message="CRT+SMC+OF: setup LARGO con delta comprador en el sweep")
alertcondition(armadoS_OF, title="VENTA con order flow a favor", message="CRT+SMC+OF: setup CORTO con delta vendedor en el sweep")
alertcondition((faseL == 3 and faseL[1] != 3) or (faseS == 3 and faseS[1] != 3), title="Cualquier setup armado", message="CRT+SMC+OF: setup armado (revisa el delta del sweep)")

if (armadoL_OF or armadoS_OF)
    dir = armadoL_OF ? "COMPRA" : "VENTA"
    lim = armadoL_OF ? limL : limS
    slx = armadoL_OF ? slL : slS
    ofx = armadoL_OF ? ofL : ofS
    alert("CRT-SMC-OF " + dir + " " + syminfo.ticker + " | E " + f_fmt(lim) + " SL " + f_fmt(slx) + " | delta sweep " + f_delt(ofx), alert.freq_once_per_bar_close)
